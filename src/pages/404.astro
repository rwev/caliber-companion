---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaliberSearch from '../components/islands/CaliberSearch';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');
const caliberIndex = calibers.map(c => ({
  name: c.data.name,
  slug: c.data.slug,
  designation: c.data.designation,
}));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Search our caliber database or explore our tools and guides.">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24 text-center">
    <!-- Big 404 -->
    <div class="mb-8">
      <div class="text-8xl font-bold text-accent/20 sm:text-9xl">404</div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Page Not Found
      </h1>
      <p class="mt-3 text-base text-text-muted">
        This page doesn't exist — but we have {calibers.length} calibers that do.
      </p>
    </div>

    <!-- Search -->
    <div class="mb-10 max-w-md mx-auto">
      <p class="mb-2 text-sm text-text-muted">Search for a caliber:</p>
      <CaliberSearch client:idle calibers={caliberIndex} basePath={base} />
    </div>

    <!-- Quick links -->
    <div class="rounded-lg border border-surface-border p-6 text-left">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted mb-4 text-center">Popular Destinations</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {[
          { href: `${base}/calibers`, label: 'Browse All Calibers', desc: '102 calibers with full data' },
          { href: `${base}/compare`, label: 'Compare Calibers', desc: 'Side-by-side comparison' },
          { href: `${base}/tools`, label: 'Interactive Tools', desc: '10 calculators and generators' },
          { href: `${base}/guides`, label: 'Buying Guides', desc: '13 use-case guides' },
          { href: `${base}/reference/firearms`, label: 'Firearms Database', desc: '100 iconic firearms' },
          { href: `${base}/guides/quiz`, label: 'Caliber Quiz', desc: 'Find your ideal caliber' },
          { href: `${base}/guides/best-deer-calibers`, label: 'Best for Deer', desc: 'Hunting recommendations' },
          { href: `${base}/guides/best-self-defense-calibers`, label: 'Best for Self-Defense', desc: 'Defensive caliber guide' },
        ].map(link => (
          <a
            href={link.href}
            class="group flex items-start gap-3 rounded-md border border-surface-border-subtle bg-surface p-3 transition-colors hover:border-accent/40 hover:bg-surface-raised"
          >
            <svg class="h-4 w-4 mt-0.5 shrink-0 text-text-muted group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            <div>
              <div class="text-sm font-medium text-text-primary group-hover:text-accent transition-colors">{link.label}</div>
              <div class="text-xs text-text-muted">{link.desc}</div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Home link -->
    <div class="mt-8">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 text-base font-medium text-text-muted transition-colors hover:text-accent"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
