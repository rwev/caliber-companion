---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtRange, fmtNumber, fmtCurrency } from '../../lib/format';

const allCalibers = await getCollection('caliberData');
const bySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

const tiers = [
  {
    title: 'Best All-Around Elk Calibers',
    calibers: ['30-06-springfield', '300-win-mag', '280-ackley-improved', '7mm-rem-mag', '270-winchester'],
    description: 'These are the proven elk calibers that have accounted for the majority of elk harvested across North America. They deliver 1,500+ ft-lbs of energy at 300 yards — the widely accepted minimum for ethical elk kills — with readily available ammunition and broad rifle selection.',
  },
  {
    title: 'Best Modern/Precision Elk Calibers',
    calibers: ['68-western', '65-prc', '300-prc', '28-nosler', '300-wsm'],
    description: 'Modern cartridges designed to extend ethical elk range through high-BC bullets, optimized case designs, and improved ballistic coefficients. These excel at 400-600 yard shots that traditional calibers struggle with.',
  },
  {
    title: 'Best Budget Elk Calibers',
    calibers: ['308-winchester', '30-06-springfield', '270-winchester', '7mm-rem-mag', '300-win-mag'],
    description: 'The cheapest path to an elk-capable rifle setup. All have abundant, affordable ammunition from multiple manufacturers and are available in budget bolt-actions like the Ruger American and Savage Axis.',
  },
  {
    title: 'Best Low-Recoil Elk Calibers',
    calibers: ['65-creedmoor', '7mm-08-remington', '280-ackley-improved', '270-winchester', '65-prc'],
    description: 'For recoil-sensitive hunters who still need elk-class terminal performance. These calibers use modern high-BC bullets to deliver adequate energy with noticeably less felt recoil than traditional magnum cartridges.',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pageDescription = 'Best calibers for elk hunting — proven performers, modern precision options, budget choices, and low-recoil alternatives. Data-driven recommendations with energy-at-range comparisons.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    { '@type': 'Question', 'name': 'What is the best caliber for elk?', 'acceptedAnswer': { '@type': 'Answer', 'text': '.30-06 Springfield and .300 Winchester Magnum are the two most popular and proven elk calibers. For shots under 300 yards, .30-06 is ideal with its moderate recoil and widespread availability. For extended range (300-500 yards), .300 Win Mag provides the extra velocity and energy needed. Modern alternatives like .280 Ackley Improved and 6.8 Western are gaining popularity.' } },
    { '@type': 'Question', 'name': 'Is 6.5 Creedmoor enough for elk?', 'acceptedAnswer': { '@type': 'Answer', 'text': '6.5 Creedmoor can ethically harvest elk under 300 yards with premium 140-143gr bonded or controlled-expansion bullets (ELD-X, Partition). However, it is at the lower end of recommended energy. Most experienced elk hunters prefer .270 Winchester or larger for the additional margin of error on these large, tough animals.' } },
    { '@type': 'Question', 'name': 'What is the minimum energy for elk?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'The widely cited minimum is 1,500 ft-lbs of energy at the point of impact. This is a guideline, not a law — shot placement and bullet construction matter more than raw energy. A 140gr bonded bullet at 1,500 ft-lbs with perfect shot placement is more effective than a 180gr bullet at 2,500 ft-lbs in the gut.' } },
  ],
};
---

<BaseLayout title="Best Calibers for Elk Hunting (2026)" description={pageDescription} breadcrumbs={[{ label: 'Guides', href: `${base}/guides` }, { label: 'Best Elk Calibers' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Best Calibers for Elk Hunting
      </h1>
      <p class="mt-3 text-base text-text-muted max-w-3xl">
        Elk are the toughest commonly hunted North American big game. Choosing the right caliber means ensuring
        adequate energy at your expected shot distance — with bullet construction to match.
      </p>
    </div>

    {tiers.map(tier => {
      const cals = tier.calibers.map(slug => bySlug.get(slug)).filter(Boolean);
      return (
        <section class="mb-10">
          <h2 class="mb-2 text-xl font-semibold text-accent border-b border-surface-border pb-3">{tier.title}</h2>
          <p class="mb-4 text-sm text-text-muted">{tier.description}</p>
          <div class="border border-surface-border rounded-lg overflow-x-auto" tabindex="0">
            <table class="w-full text-left font-mono">
              <thead>
                <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide">Caliber</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Energy</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Eff. Range</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Recoil</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Cost/Rd</th>
                </tr>
              </thead>
              <tbody>
                {cals.map((c, i) => (
                  <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                    <td class="px-3 py-2"><a href={`${base}/calibers/${c!.slug}`} class="text-sm font-medium text-text-primary hover:text-accent transition-colors">{c!.name}</a></td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtRange(c!.typical_energy_ft_lbs, 'ft·lbs')}</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtNumber(c!.effective_range_yd)} yd</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{c!.recoil.free_recoil_ft_lbs} ft·lbs</td>
                    <td class="px-3 py-2 text-sm text-right text-text-muted">{fmtCurrency(c!.cost_per_round_usd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}

    <section class="mt-12 border-t border-surface-border pt-8">
      <h2 class="text-xl font-semibold text-text-muted mb-4">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          { q: 'What bullet type should I use for elk?', a: 'Bonded or controlled-expansion bullets: Nosler Partition, Federal Trophy Bonded, Hornady ELD-X, Barnes TTSX. These retain weight and penetrate deep through heavy bone and muscle. Avoid fragile varmint bullets or FMJ — elk require deep, reliable penetration.' },
          { q: '.308 Winchester or .30-06 for elk?', a: '.30-06 is the better elk caliber. It pushes the same bullets 100-150 fps faster, delivering noticeably more energy at distance. With a 180gr bullet, .30-06 carries 1,500+ ft-lbs past 350 yards vs. ~300 yards for .308. Both work under 250 yards, but .30-06 provides more margin.' },
          { q: 'Do I need a magnum for elk?', a: 'No. .270 Winchester, .280 AI, and .30-06 have cleanly taken thousands of elk within 300 yards. Magnums (.300 WM, 7mm RM) extend your ethical range to 400-500 yards. Choose based on your realistic shooting distance, not marketing.' },
        ].map(faq => (
          <details class="group border border-surface-border rounded-lg">
            <summary class="flex cursor-pointer items-center justify-between bg-surface-raised px-4 py-3 text-sm text-text-primary transition-colors hover:bg-surface-overlay">
              <span>{faq.q}</span>
              <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-surface-border-subtle bg-surface px-4 py-3">
              <p class="text-sm text-text-secondary leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-8 flex flex-wrap gap-3 border-t border-surface-border pt-6">
      <span class="text-xs font-medium uppercase tracking-wide text-text-muted self-center">Related:</span>
      <a href={`${base}/guides/best-calibers-for-elk`} class="text-sm text-accent hover:underline">Elk Guide</a>
      <a href={`${base}/guides/best-deer-calibers`} class="text-sm text-accent hover:underline">Deer Calibers</a>
      <a href={`${base}/tools/ethical-range`} class="text-sm text-accent hover:underline">Ethical Range Calculator</a>
      <a href={`${base}/reference/hunting-regulations`} class="text-sm text-accent hover:underline">Hunting Regulations</a>
    </div>
  </div>
</BaseLayout>
