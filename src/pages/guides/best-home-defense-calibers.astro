---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtRange, fmtNumber, fmtCurrency, titleCase } from '../../lib/format';

const allCalibers = await getCollection('caliberData');
const bySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

const tiers = [
  {
    title: 'Best Handgun Calibers for Home Defense',
    calibers: ['9mm-luger', '45-acp', '357-magnum', '40-sw', '10mm-auto'],
    description: 'A handgun is the most versatile home defense tool — it frees one hand for flashlights, phones, or children. 9mm in a full-size pistol offers the best combination of capacity, controllability, and terminal effectiveness. The .357 Magnum revolver remains a time-proven choice for those who prefer revolvers.',
  },
  {
    title: 'Best Rifle/Carbine Calibers',
    calibers: ['556x45mm-nato', '300-blackout', '762x39mm', '9mm-luger', '45-acp'],
    description: '5.56 NATO in an AR-15 is the most recommended home defense rifle platform. Counter-intuitively, 5.56 penetrates fewer walls than handgun rounds or buckshot because the lightweight bullet fragments and tumbles on impact. .300 Blackout suppressed with subsonic loads is ideal for indoor use without hearing protection.',
  },
  {
    title: 'Best Shotgun Loads',
    calibers: ['12-gauge', '20-gauge', '410-bore'],
    description: '12 gauge with 00 buckshot remains the classic home defense choice. The 20 gauge is increasingly popular for smaller-framed shooters — modern defensive loads close the performance gap with 12 gauge. The .410 bore in the Taurus Judge/S&W Governor is a niche option with limited stopping power.',
  },
  {
    title: 'Over-Penetration Considerations',
    calibers: ['556x45mm-nato', '9mm-luger', '12-gauge', '300-blackout'],
    description: 'In shared-wall environments (apartments, townhomes), over-penetration is a primary safety concern. 5.56 NATO with frangible or hollow point ammunition penetrates fewer interior walls than 9mm FMJ or 00 buckshot. .300 Blackout subsonic loads are another low-penetration option. Always use expanding ammunition — never FMJ for home defense.',
  },
];

const pageDescription = 'Best calibers for home defense — handguns, rifles, and shotguns rated for stopping power, over-penetration risk, and indoor practicality. Data-driven recommendations for apartments, houses, and rural homes.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    { '@type': 'Question', 'name': 'What is the best caliber for home defense?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'For handguns: 9mm Luger in a full-size or compact pistol offers the best balance of capacity, recoil control, and terminal effectiveness. For rifles: 5.56 NATO in an AR-15 provides superior stopping power with less wall penetration risk than handgun calibers. For shotguns: 12 gauge with 00 buckshot or #1 buckshot.' } },
    { '@type': 'Question', 'name': 'Does 5.56 penetrate walls less than 9mm?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Yes. 5.56 NATO with expanding ammunition (not M855/green tip) fragments and tumbles when hitting drywall, penetrating fewer walls than 9mm or .45 ACP. This makes it safer in shared-wall environments, though no caliber is \"wall-safe.\"' } },
    { '@type': 'Question', 'name': 'Is a shotgun or AR-15 better for home defense?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Both are excellent. The AR-15 offers higher capacity (30 rounds), lower recoil, less wall penetration with proper ammo, and easier mounting of lights/optics. The shotgun offers devastating close-range stopping power and is legal everywhere. Choose based on your training, living situation, and comfort level.' } },
  ],
};
---

<BaseLayout title="Best Calibers for Home Defense (2026)" description={pageDescription} breadcrumbs={[{ label: 'Guides', href: '/guides' }, { label: 'Best Home Defense Calibers' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Best Calibers for Home Defense
      </h1>
      <p class="mt-3 text-base text-text-muted max-w-3xl">
        Handgun, rifle, and shotgun calibers rated for stopping power, over-penetration risk, and indoor practicality. Includes wall penetration considerations for apartments vs. houses.
      </p>
    </div>

    {tiers.map(tier => {
      const cals = tier.calibers.map(slug => bySlug.get(slug)).filter(Boolean);
      return (
        <section class="mb-10">
          <h2 class="mb-2 text-xl font-semibold text-accent border-b border-surface-border pb-3">{tier.title}</h2>
          <p class="mb-4 text-sm text-text-muted">{tier.description}</p>
          <div class="border border-surface-border rounded-lg overflow-x-auto" tabindex="0">
            <table class="w-full text-left font-mono">
              <thead>
                <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide">Caliber</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Energy</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Recoil</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Cost/Rd</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-center">Avail.</th>
                </tr>
              </thead>
              <tbody>
                {cals.map((c, i) => (
                  <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                    <td class="px-3 py-2"><a href={`/calibers/${c!.slug}`} class="text-sm font-medium text-text-primary hover:text-accent transition-colors">{c!.name}</a></td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtRange(c!.typical_energy_ft_lbs, 'ft·lbs')}</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{c!.recoil.free_recoil_ft_lbs} ft·lbs</td>
                    <td class="px-3 py-2 text-sm text-right text-text-muted">{fmtCurrency(c!.cost_per_round_usd)}</td>
                    <td class="px-3 py-2 text-sm text-center text-text-muted">{c!.availability_rating ?? '—'}/5</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}

    <!-- FAQ -->
    <section class="mt-12 border-t border-surface-border pt-8">
      <h2 class="text-xl font-semibold text-text-muted mb-4">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          { q: 'What is the best home defense handgun caliber?', a: '9mm Luger. It offers 15-17 round capacity in full-size pistols, manageable recoil for rapid follow-up shots, proven terminal performance with modern JHP, and the cheapest practice ammunition of any centerfire handgun caliber.' },
          { q: 'Should I use FMJ or hollow points for home defense?', a: 'Always use hollow point (JHP) or other expanding ammunition for home defense. FMJ over-penetrates, passing through an attacker and potentially hitting bystanders or entering adjacent rooms. Federal HST, Speer Gold Dot, and Hornady Critical Duty are proven performers.' },
          { q: 'Is .300 Blackout good for home defense?', a: 'Excellent, especially suppressed. .300 Blackout subsonic loads (190-220gr at ~1,050 fps) are hearing-safe with a suppressor, making it one of the few calibers that can be fired indoors without permanent hearing damage. Supersonic loads offer rifle-level terminal performance in a compact AR-15 platform.' },
        ].map(faq => (
          <details class="group border border-surface-border rounded-lg">
            <summary class="flex cursor-pointer items-center justify-between bg-surface-raised px-4 py-3 text-sm text-text-primary transition-colors hover:bg-surface-overlay">
              <span>{faq.q}</span>
              <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-surface-border-subtle bg-surface px-4 py-3">
              <p class="text-sm text-text-secondary leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-8 flex flex-wrap gap-3 border-t border-surface-border pt-6">
      <span class="text-xs font-medium uppercase tracking-wide text-text-muted self-center">Related:</span>
      <a href="/guides/best-self-defense-calibers" class="text-sm text-accent hover:underline">CCW / Self-Defense Guide</a>
      <a href="/guides/best-calibers-for-home-defense" class="text-sm text-accent hover:underline">Home Defense Guide</a>
      <a href="/reference/terminal-performance" class="text-sm text-accent hover:underline">Terminal Performance Data</a>
    </div>
  </div>
</BaseLayout>
