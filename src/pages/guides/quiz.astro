---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaliberQuiz from '../../components/islands/CaliberQuiz';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');

const caliberInfos = calibers.map(c => ({
  name: c.data.name,
  slug: c.data.slug,
  category: c.data.category,
  typical_energy_ft_lbs: c.data.typical_energy_ft_lbs,
  effective_range_yd: c.data.effective_range_yd,
  recoil_subjective: c.data.recoil.subjective,
  popularity_tier: c.data.popularity_tier,
  cost_per_round_usd: c.data.cost_per_round_usd,
  primary_use_cases: c.data.primary_use_cases,
}));
---

<BaseLayout breadcrumbs={[{ label: 'Guides', href: '/guides' }, { label: 'Caliber Quiz' }]} title="Caliber Quiz" description="Answer a few questions and get personalized caliber recommendations from our database of 100 cartridges.">
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Find Your Caliber
      </h1>
      <p class="mt-2 text-base text-text-muted">
        Answer a few questions and get personalized caliber recommendations from our database of <span class="font-mono">{calibers.length}</span> cartridges.
      </p>
    </div>

    <CaliberQuiz client:load calibers={caliberInfos} basePath="" />
  </div>
</BaseLayout>
