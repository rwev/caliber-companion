---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtRange, fmtNumber, fmtCurrency } from '../../lib/format';

const allCalibers = await getCollection('caliberData');
const bySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

const tiers = [
  {
    title: 'Best Handgun Calibers for Bear Defense',
    calibers: ['10mm-auto', '44-magnum', '454-casull', '460-sw-magnum', '500-sw-magnum'],
    description: 'When hiking, fishing, or camping in bear country, a handgun is the most practical carry option. 10mm Auto in a Glock 20 is the minimum recommended, with .44 Magnum being the traditional standard. For grizzly/brown bear, step up to .454 Casull or larger.',
  },
  {
    title: 'Best Rifle/Shotgun Calibers',
    calibers: ['45-70-government', '12-gauge', '375-hh-magnum', '375-ruger', '338-winchester-magnum'],
    description: 'For dedicated bear country carry or guided hunts, a lever-action .45-70 or pump shotgun with slugs provides maximum stopping power with fast follow-up capability. For brown bear and grizzly at close range, heavy hard-cast bullets and deep-penetrating loads are essential.',
  },
  {
    title: 'Minimum Viable Bear Defense',
    calibers: ['357-magnum', '10mm-auto', '44-magnum', '45-colt', '327-federal-magnum'],
    description: 'Not everyone can handle magnum recoil. These calibers represent the practical minimum for bear defense — they can work with proper ammunition (hard-cast or monolithic bullets) and accurate shot placement. The .357 Magnum with 180gr hard-cast loads is the lowest recommended option.',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pageDescription = 'Best calibers for bear defense — handguns and rifles rated for stopping grizzly, brown, and black bears. Minimum caliber recommendations and ammunition selection for bear country.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    { '@type': 'Question', 'name': 'What is the best caliber for bear defense?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'For handguns: 10mm Auto (minimum) or .44 Magnum (recommended) with hard-cast or monolithic bullets. For rifles: .45-70 Government in a lever-action or 12 gauge with slugs. The key is deep penetration through heavy bone — use hard-cast lead or solid copper bullets, never hollow points.' } },
    { '@type': 'Question', 'name': 'Is 9mm enough for bear defense?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'No. 9mm lacks the penetration needed to reliably stop a charging bear through heavy muscle and bone. The minimum recommended handgun caliber for bear defense is .357 Magnum with 180gr hard-cast bullets, with 10mm Auto or .44 Magnum strongly preferred.' } },
    { '@type': 'Question', 'name': 'What bullet type for bear defense?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Hard-cast lead flat nose (Buffalo Bore, Underwood) or monolithic copper solids (Barnes, Lehigh). Never use hollow points — they expand too quickly and fail to penetrate deep enough. Bear defense requires 24+ inches of straight-line penetration through heavy bone and muscle.' } },
  ],
};
---

<BaseLayout title="Best Calibers for Bear Defense (2026)" description={pageDescription} breadcrumbs={[{ label: 'Guides', href: `${base}/guides` }, { label: 'Best Bear Defense Calibers' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Best Calibers for Bear Defense
      </h1>
      <p class="mt-3 text-base text-text-muted max-w-3xl">
        Handgun and rifle calibers rated for stopping grizzly, brown, and black bears. Deep penetration with hard-cast or monolithic bullets is essential — this is not about expansion, it's about reaching vital organs through heavy bone.
      </p>
    </div>

    {tiers.map(tier => {
      const cals = tier.calibers.map(slug => bySlug.get(slug)).filter(Boolean);
      return (
        <section class="mb-10">
          <h2 class="mb-2 text-xl font-semibold text-accent border-b border-surface-border pb-3">{tier.title}</h2>
          <p class="mb-4 text-sm text-text-muted">{tier.description}</p>
          <div class="rounded-lg border border-surface-border overflow-x-auto" tabindex="0">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide">Caliber</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Energy</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Recoil</th>
                  <th scope="col" class="px-3 py-2 text-xs font-medium uppercase tracking-wide text-right">Cost/Rd</th>
                </tr>
              </thead>
              <tbody>
                {cals.map((c, i) => (
                  <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                    <td class="px-3 py-2"><a href={`${base}/calibers/${c!.slug}`} class="text-sm font-medium text-text-primary hover:text-accent transition-colors">{c!.name}</a></td>
                    <td class="px-3 py-2 font-mono text-sm text-right text-text-secondary">{fmtRange(c!.typical_energy_ft_lbs, 'ft·lbs')}</td>
                    <td class="px-3 py-2 font-mono text-sm text-right text-text-secondary">{c!.recoil.free_recoil_ft_lbs} ft·lbs</td>
                    <td class="px-3 py-2 font-mono text-sm text-right text-text-muted">{fmtCurrency(c!.cost_per_round_usd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}

    <section class="mt-12 border-t border-surface-border pt-8">
      <h2 class="text-xl font-semibold text-text-muted mb-4">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          { q: 'Bear spray or gun for bear defense?', a: 'Both. Bear spray is statistically more effective at preventing injury in bear encounters and should be your first line of defense. A firearm is the backup for when spray fails or isn\'t deployed in time. Carry both — spray accessible on your chest, firearm in a quality holster.' },
          { q: '10mm Auto vs .44 Magnum for bears?', a: '10mm Auto: 15+1 capacity, faster follow-ups, lighter gun (Glock 20). .44 Magnum: more energy per shot, deeper penetration with heavy hard-cast, proven track record. For grizzly, .44 Mag is preferred. For black bear, 10mm is more than adequate. Both work with proper ammunition.' },
          { q: 'What about .45 ACP for bear defense?', a: '.45 ACP lacks the velocity and penetration for reliable bear defense. Even with hard-cast +P loads, it produces only ~500 ft-lbs — well below the 700+ ft-lbs minimum recommended. Stick with 10mm Auto or larger for bear country.' },
        ].map(faq => (
          <details class="group rounded-lg border border-surface-border">
            <summary class="flex cursor-pointer items-center justify-between bg-surface-raised px-4 py-3 text-sm text-text-primary transition-colors hover:bg-surface-overlay">
              <span>{faq.q}</span>
              <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-surface-border-subtle bg-surface px-4 py-3">
              <p class="text-sm text-text-secondary leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-8 flex flex-wrap gap-3 border-t border-surface-border pt-6">
      <span class="text-xs font-medium uppercase tracking-wide text-text-muted self-center">Related:</span>
      <a href={`${base}/guides/best-calibers-for-bear-defense`} class="text-sm text-accent hover:underline">Bear Defense Guide</a>
      <a href={`${base}/guides/best-elk-calibers`} class="text-sm text-accent hover:underline">Elk Calibers</a>
      <a href={`${base}/tools/ethical-range`} class="text-sm text-accent hover:underline">Ethical Range Calculator</a>
      <a href={`${base}/reference/recoil-ranking`} class="text-sm text-accent hover:underline">Recoil Ranking</a>
    </div>
  </div>
</BaseLayout>
