---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const sorted = guides.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout breadcrumbs={[{ label: 'Guides' }]} title="Guides" description="Curated caliber recommendation guides for home defense, hunting, competition, concealed carry, and more.">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Caliber Guides
      </h1>
      <p class="mt-2 font-mono text-base text-text-muted">
        Curated recommendations for specific use cases
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map(guide => (
        <a
          href={`/caliber-companion/guides/${guide.data.slug}`}
          class="group border border-surface-border bg-surface-raised p-5 transition-colors hover:border-accent"
        >
          <h2 class="font-display text-lg font-semibold tracking-wide text-text-primary group-hover:text-accent transition-colors">
            {guide.data.title}
          </h2>
          <p class="mt-2 font-mono text-sm text-text-muted leading-relaxed">
            {guide.data.summary}
          </p>
          <div class="mt-3 font-mono text-xs text-accent">
            {guide.data.calibers.length} calibers reviewed →
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
