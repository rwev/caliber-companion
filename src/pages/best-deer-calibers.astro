---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtRange, fmtNumber, titleCase } from '../lib/format';

const allCalibers = await getCollection('caliberData');
const bySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

// Curated deer caliber recommendations
const tiers = [
  {
    title: 'Best Overall for Whitetail Under 200 Yards',
    calibers: ['308-winchester', '270-winchester', '30-06-springfield', '243-winchester', '7mm-08-remington'],
    description: 'These cartridges have taken more deer than any others. They offer the ideal balance of power, accuracy, availability, and mild recoil for shots under 200 yards — where the vast majority of whitetail deer are harvested.',
  },
  {
    title: 'Best for Long-Range Deer (200–500 Yards)',
    calibers: ['65-creedmoor', '270-winchester', '280-ackley-improved', '7mm-rem-mag', '65-prc'],
    description: 'When you need to reach across open fields, food plots, or power line cuts, these high-BC cartridges retain energy and resist wind drift far better than traditional options. All carry well over 1,000 ft-lbs past 400 yards.',
  },
  {
    title: 'Best Low-Recoil Deer Calibers',
    calibers: ['243-winchester', '7mm-08-remington', '65-creedmoor', '6mm-arc', '350-legend'],
    description: 'For recoil-sensitive, youth, and new hunters. These calibers all deliver ethical deer performance with noticeably less felt recoil than traditional choices like .30-06 or .300 Win Mag.',
  },
  {
    title: 'Best for Straight-Wall States',
    calibers: ['350-legend', '450-bushmaster', '45-70-government', '44-magnum', '30-30-winchester'],
    description: 'Several states (Ohio, Iowa, Indiana, Michigan, and others) require straight-wall cartridges for rifle deer hunting. These are the top choices for those regulations.',
  },
  {
    title: 'Best Budget Deer Calibers',
    calibers: ['308-winchester', '30-06-springfield', '270-winchester', '762x39mm', '30-30-winchester'],
    description: 'When ammunition cost and availability matter. These calibers offer the cheapest practice and hunting ammo with the widest selection at any sporting goods store.',
  },
];

const pageDescription = 'The best calibers for deer hunting in 2026 — from under-200-yard whitetail to long-range, low-recoil, straight-wall, and budget options. Data-driven recommendations with ballistic comparisons.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is the best caliber for deer hunting?',
      'acceptedAnswer': { '@type': 'Answer', 'text': '.308 Winchester, .270 Winchester, and .30-06 Springfield are the three most popular and effective deer hunting calibers. For new hunters or those sensitive to recoil, .243 Winchester and 7mm-08 Remington are excellent lower-recoil alternatives.' },
    },
    {
      '@type': 'Question',
      'name': 'What is the best caliber for deer under 200 yards?',
      'acceptedAnswer': { '@type': 'Answer', 'text': '.308 Winchester is arguably the best all-around deer caliber under 200 yards. It offers excellent terminal performance, wide ammunition selection, moderate recoil, and is available in nearly every rifle platform.' },
    },
    {
      '@type': 'Question',
      'name': 'Is .223 Remington enough for deer?',
      'acceptedAnswer': { '@type': 'Answer', 'text': '.223 Remington can ethically harvest deer under 150 yards with proper bullet selection (62-77 grain controlled expansion), but it is not ideal. Most experienced hunters recommend .243 Winchester as the minimum for consistent deer hunting performance.' },
    },
    {
      '@type': 'Question',
      'name': 'What caliber has the least recoil for deer hunting?',
      'acceptedAnswer': { '@type': 'Answer', 'text': '.243 Winchester offers the least recoil among commonly recommended deer calibers, at approximately 8-9 ft-lbs of free recoil energy. The .350 Legend also offers very mild recoil and is legal in straight-wall states.' },
    },
  ],
};
---

<BaseLayout title="Best Calibers for Deer Hunting (2026)" description={pageDescription} breadcrumbs={[{ label: 'Best Deer Calibers' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Best Calibers for Deer Hunting
      </h1>
      <p class="mt-3 font-mono text-base text-text-muted max-w-3xl">
        Data-driven recommendations across 5 categories: overall, long-range, low-recoil, straight-wall states, and budget.
        Based on energy at range, recoil data, ammunition cost, and availability from our database of 102 calibers.
      </p>
    </div>

    {tiers.map(tier => {
      const cals = tier.calibers.map(slug => bySlug.get(slug)).filter(Boolean);
      return (
        <section class="mb-10">
          <h2 class="mb-2 font-display text-xl font-semibold tracking-[0.15em] uppercase text-accent border-b border-surface-border pb-3">
            {tier.title}
          </h2>
          <p class="mb-4 font-mono text-sm text-text-muted">{tier.description}</p>

          <div class="border border-surface-border overflow-x-auto" tabindex="0" role="region" aria-label={tier.title}>
            <table class="w-full text-left font-mono">
              <thead>
                <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs">Caliber</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Energy</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Eff. Range</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Recoil</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Cost/Rd</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-center">Avail.</th>
                </tr>
              </thead>
              <tbody>
                {cals.map((c, i) => (
                  <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                    <td class="px-3 py-2">
                      <a href={`/caliber-companion/calibers/${c!.slug}`} class="text-sm font-medium text-text-primary hover:text-accent transition-colors">
                        {c!.name}
                      </a>
                    </td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtRange(c!.typical_energy_ft_lbs, 'ft·lbs')}</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtNumber(c!.effective_range_yd)} yd</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{c!.recoil.free_recoil_ft_lbs} ft·lbs</td>
                    <td class="px-3 py-2 text-sm text-right text-text-muted">${c!.cost_per_round_usd[0].toFixed(2)}–${c!.cost_per_round_usd[1].toFixed(2)}</td>
                    <td class="px-3 py-2 text-sm text-center text-text-muted">{c!.availability_rating ?? '—'}/5</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}

    <!-- FAQ -->
    <section class="mt-12 border-t border-surface-border pt-8">
      <h2 class="font-display text-xl font-semibold tracking-[0.2em] uppercase text-text-muted mb-4">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          { q: 'What is the best overall caliber for deer hunting?', a: '.308 Winchester remains the gold standard — excellent terminal performance, moderate recoil, ubiquitous availability, and works in every rifle platform from bolt-action to semi-auto. The .270 Winchester and .30-06 Springfield are equally proven alternatives.' },
          { q: 'What is the minimum caliber for deer?', a: 'Most experts recommend .243 Winchester (6mm) as the practical minimum for deer-sized game. While smaller calibers like .223 can work with perfect shot placement, the margin for error is too slim for ethical hunting. .243 Win provides adequate energy (1,900+ ft-lbs) with minimal recoil.' },
          { q: 'Is 6.5 Creedmoor good for deer?', a: 'Excellent. The 6.5 Creedmoor offers a near-ideal combination of flat trajectory, low recoil, and retained energy at distance. A 143gr ELD-X at 400 yards still carries over 1,400 ft-lbs — well above the 1,000 ft-lbs minimum for deer.' },
          { q: 'What caliber for deer in a straight-wall state?', a: '.350 Legend is purpose-built for straight-wall regulations with mild recoil and flat trajectory. For more power, .450 Bushmaster and .45-70 Government are popular. .30-30 Winchester also qualifies in many jurisdictions.' },
        ].map(faq => (
          <details class="group border border-surface-border">
            <summary class="flex cursor-pointer items-center justify-between bg-surface-raised px-4 py-3 font-mono text-sm text-text-primary transition-colors hover:bg-surface-overlay">
              <span>{faq.q}</span>
              <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="border-t border-surface-border-subtle bg-surface px-4 py-3">
              <p class="font-mono text-sm text-text-secondary leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related -->
    <div class="mt-8 flex flex-wrap gap-3 border-t border-surface-border pt-6">
      <span class="font-mono text-xs tracking-wider uppercase text-text-muted self-center">Related:</span>
      <a href="/caliber-companion/guides/best-calibers-for-whitetail" class="font-mono text-sm text-accent hover:underline">Whitetail Guide</a>
      <a href="/caliber-companion/guides/best-calibers-for-elk" class="font-mono text-sm text-accent hover:underline">Elk Guide</a>
      <a href="/caliber-companion/tools/ethical-range" class="font-mono text-sm text-accent hover:underline">Ethical Range Calculator</a>
      <a href="/caliber-companion/compare" class="font-mono text-sm text-accent hover:underline">Compare Calibers</a>
      <a href="/caliber-companion/recoil-ranking" class="font-mono text-sm text-accent hover:underline">Recoil Ranking</a>
    </div>
  </div>
</BaseLayout>
