---
/**
 * Redirect from old /vs/[slug] URLs to new /compare/[slug] URLs.
 * Preserves SEO link equity for any existing backlinks.
 */
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const matchups: [string, string][] = [
    ['9mm-luger', '45-acp'],
    ['9mm-luger', '40-sw'],
    ['9mm-luger', '380-acp'],
    ['9mm-luger', '10mm-auto'],
    ['9mm-luger', '357-sig'],
    ['45-acp', '10mm-auto'],
    ['40-sw', '45-acp'],
    ['380-acp', '38-special'],
    ['357-magnum', '38-special'],
    ['357-magnum', '44-magnum'],
    ['556x45mm-nato', '762x39mm'],
    ['556x45mm-nato', '300-blackout'],
    ['556x45mm-nato', '308-winchester'],
    ['556x45mm-nato', '65-creedmoor'],
    ['308-winchester', '65-creedmoor'],
    ['308-winchester', '30-06-springfield'],
    ['308-winchester', '762x39mm'],
    ['308-winchester', '300-win-mag'],
    ['65-creedmoor', '6mm-creedmoor'],
    ['65-creedmoor', '65-prc'],
    ['65-creedmoor', '30-06-springfield'],
    ['30-06-springfield', '270-winchester'],
    ['30-06-springfield', '300-win-mag'],
    ['300-blackout', '762x39mm'],
    ['300-win-mag', '338-lapua-magnum'],
    ['270-winchester', '7mm-rem-mag'],
    ['7mm-rem-mag', '300-win-mag'],
    ['22-lr', '22-wmr'],
    ['12-gauge', '20-gauge'],
    ['50-bmg', '338-lapua-magnum'],
    ['65-creedmoor', '6mm-arc'],
    ['6mm-arc', '556x45mm-nato'],
    ['6mm-arc', '65-grendel'],
    ['6mm-creedmoor', '6mm-arc'],
    ['68-western', '270-winchester'],
    ['68-western', '270-wsm'],
    ['68-western', '65-prc'],
    ['68-western', '7mm-rem-mag'],
    ['280-ackley-improved', '280-remington'],
    ['280-ackley-improved', '7mm-rem-mag'],
    ['280-ackley-improved', '65-creedmoor'],
    ['65-prc', '300-win-mag'],
    ['308-winchester', '6mm-arc'],
    ['300-blackout', '556x45mm-nato'],
    ['10mm-auto', '357-magnum'],
    ['44-magnum', '45-colt'],
    ['300-win-mag', '300-wsm'],
    ['338-lapua-magnum', '300-prc'],
  ];

  const allCalibers = await getCollection('caliberData');
  const slugSet = new Set(allCalibers.map(c => c.data.slug));

  return matchups
    .filter(([a, b]) => slugSet.has(a) && slugSet.has(b))
    .map(([slugA, slugB]) => ({
      params: { slug: `${slugA}-vs-${slugB}` },
    }));
}

const { slug } = Astro.params;
return Astro.redirect(`/compare/${slug}`, 301);
---
