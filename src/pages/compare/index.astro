---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTool from '../../components/islands/ComparisonTool';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');

const matchups: [string, string][] = [
  ['9mm-luger', '45-acp'], ['9mm-luger', '40-sw'], ['9mm-luger', '380-acp'],
  ['9mm-luger', '10mm-auto'], ['9mm-luger', '357-sig'], ['45-acp', '10mm-auto'],
  ['40-sw', '45-acp'], ['380-acp', '38-special'], ['357-magnum', '38-special'],
  ['357-magnum', '44-magnum'], ['556x45mm-nato', '762x39mm'], ['556x45mm-nato', '300-blackout'],
  ['556x45mm-nato', '308-winchester'], ['556x45mm-nato', '65-creedmoor'],
  ['308-winchester', '65-creedmoor'], ['308-winchester', '30-06-springfield'],
  ['308-winchester', '762x39mm'], ['308-winchester', '300-win-mag'],
  ['65-creedmoor', '6mm-creedmoor'], ['65-creedmoor', '65-prc'],
  ['65-creedmoor', '30-06-springfield'], ['30-06-springfield', '270-winchester'],
  ['30-06-springfield', '300-win-mag'], ['300-blackout', '762x39mm'],
  ['300-win-mag', '338-lapua-magnum'], ['270-winchester', '7mm-rem-mag'],
  ['7mm-rem-mag', '300-win-mag'], ['22-lr', '22-wmr'], ['12-gauge', '20-gauge'],
  ['50-bmg', '338-lapua-magnum'], ['65-creedmoor', '6mm-arc'],
  ['6mm-arc', '556x45mm-nato'], ['6mm-arc', '65-grendel'],
  ['6mm-creedmoor', '6mm-arc'], ['68-western', '270-winchester'],
  ['68-western', '270-wsm'], ['68-western', '65-prc'], ['68-western', '7mm-rem-mag'],
  ['280-ackley-improved', '280-remington'], ['280-ackley-improved', '7mm-rem-mag'],
  ['280-ackley-improved', '65-creedmoor'], ['65-prc', '300-win-mag'],
  ['308-winchester', '6mm-arc'], ['300-blackout', '556x45mm-nato'],
  ['10mm-auto', '357-magnum'], ['44-magnum', '45-colt'],
  ['300-win-mag', '300-wsm'], ['338-lapua-magnum', '300-prc'],
];

const caliberNames = new Map(calibers.map(c => [c.data.slug, c.data.name]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Compare Calibers',
  description: 'Side-by-side caliber comparisons with interactive ballistics charts, specs, and performance data.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: matchups.length,
    itemListElement: matchups.map(([a, b], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${caliberNames.get(a) ?? a} vs ${caliberNames.get(b) ?? b}`,
      url: `https://rwev.github.io/compare/${a}-vs-${b}`,
    })),
  },
};

const allCaliberData = calibers.map(c => ({
  name: c.data.name,
  designation: c.data.designation,
  slug: c.data.slug,
  category: c.data.category,
  dimensions: {
    bullet_diameter_in: c.data.dimensions.bullet_diameter_in,
    case_length_in: c.data.dimensions.case_length_in,
    overall_length_in: c.data.dimensions.overall_length_in,
    case_type: c.data.dimensions.case_type,
  },
  typical_velocity_fps: c.data.typical_velocity_fps,
  typical_energy_ft_lbs: c.data.typical_energy_ft_lbs,
  typical_bullet_weight_gr: c.data.typical_bullet_weight_gr,
  effective_range_yd: c.data.effective_range_yd,
  recoil: {
    free_recoil_ft_lbs: c.data.recoil.free_recoil_ft_lbs,
    subjective: c.data.recoil.subjective,
  },
  year_introduced: c.data.year_introduced,
  country_of_origin: c.data.country_of_origin,
  popularity_tier: c.data.popularity_tier,
  cost_per_round_usd: c.data.cost_per_round_usd,
  loads: c.data.loads,
}));
---

<BaseLayout breadcrumbs={[{ label: 'Compare' }]} title="Compare Calibers" description="Compare up to 4 calibers side-by-side with interactive ballistics charts, specs, and performance data." jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Compare Calibers
      </h1>
      <p class="mt-2 text-base text-text-muted">
        Side-by-side specifications and ballistics
      </p>
    </div>

    <ComparisonTool client:load calibers={allCaliberData} basePath="" />

    <!-- Pre-built comparisons (static links for SEO) -->
    <div class="mt-12">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-text-muted">Pre-built Comparisons</h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {matchups.map(([a, b]) => (
          <a
            href={`/compare/${a}-vs-${b}`}
            class="rounded border border-surface-border px-3 py-2 text-sm text-text-secondary transition-colors hover:border-accent/40 hover:text-accent"
          >
            {caliberNames.get(a) ?? a} vs {caliberNames.get(b) ?? b}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
