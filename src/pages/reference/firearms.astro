---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { titleCase, fmtNumber } from '../../lib/format';

const firearms = await getCollection('firearmsData');
const sorted = [...firearms].sort((a, b) => a.data.name.localeCompare(b.data.name));

// Group by type
const groups = new Map<string, typeof sorted>();
for (const f of sorted) {
  const type = f.data.type;
  if (!groups.has(type)) groups.set(type, []);
  groups.get(type)!.push(f);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const typeOrder = ['pistol', 'revolver', 'rifle', 'carbine', 'shotgun', 'submachine_gun'];
const sortedGroups = typeOrder
  .filter(t => groups.has(t))
  .map(t => ({ type: t, items: groups.get(t)! }));
---

<BaseLayout title="Firearms" description="Database of 50 iconic firearms with specs, caliber cross-references, and manufacturer details." breadcrumbs={[{ label: 'Reference', href: `${base}/reference` }, { label: 'Firearms' }]}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Firearms Database
      </h1>
      <p class="mt-2 text-base text-text-muted">
        {firearms.length} iconic firearms · specs and caliber cross-references
      </p>
    </div>

    {sortedGroups.map(({ type, items }) => (
      <div class="mb-10">
        <h2 class="mb-4 text-xl font-semibold text-accent border-b border-surface-border pb-3">
          {titleCase(type)}s
        </h2>
        <div class="rounded-lg overflow-x-auto" tabindex="0" role="region" aria-label={`${titleCase(type)} firearms`}>
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide">Name</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide">Manufacturer</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide">Caliber</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide text-right">Action</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide text-right">Barrel</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide text-right">Weight</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide text-right">Year</th>
                <th scope="col" class="px-4 py-2 text-xs font-medium uppercase tracking-wide text-center">Find</th>
              </tr>
            </thead>
            <tbody>
              {items.map((f, i) => (
                <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                  <td class="px-4 py-2.5">
                    <span class="text-base font-medium text-text-primary">{f.data.name}</span>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-text-secondary">{f.data.manufacturer}</td>
                  <td class="px-4 py-2.5">
                    <a href={`${base}/calibers/${f.data.caliber}`} class="font-mono text-sm text-accent hover:underline">
                      {f.data.caliber}
                    </a>
                  </td>
                  <td class="px-4 py-2.5 text-right text-sm text-text-secondary">{f.data.action}</td>
                  <td class="px-4 py-2.5 text-right font-mono text-sm text-text-primary">{f.data.barrel_length_in}"</td>
                  <td class="px-4 py-2.5 text-right font-mono text-sm text-text-primary">{(f.data.weight_oz / 16).toFixed(1)} lb</td>
                  <td class="px-4 py-2.5 text-right font-mono text-sm text-text-muted">{f.data.year_introduced}</td>
                  <td class="px-4 py-2.5 text-center">
                    <div class="flex items-center justify-center gap-1.5">
                      <a
                        href={`https://www.brownells.com/search?q=${encodeURIComponent(f.data.manufacturer + ' ' + f.data.name)}`}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="text-text-muted hover:text-accent transition-colors"
                        title={`Search Brownells for ${f.data.name}`}
                      >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <p class="mt-4 text-xs text-text-muted">
      External links open retailer search results. Prices and availability vary by retailer and location.
    </p>
  </div>
</BaseLayout>
