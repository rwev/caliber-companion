---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtRange, fmtNumber, fmtCurrency, titleCase } from '../lib/format';

const allCalibers = await getCollection('caliberData');
const bySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

const tiers = [
  {
    title: 'Best for 500–1,000 Yards',
    calibers: ['65-creedmoor', '308-winchester', '6mm-creedmoor', '6mm-arc', '260-remington'],
    description: 'The sweet spot for most precision shooters. These calibers offer manageable recoil, excellent accuracy, reasonable barrel life, and widely available match ammunition. The 6.5 Creedmoor dominates this range for good reason — but the others each have specific advantages.',
  },
  {
    title: 'Best for 1,000–1,500 Yards',
    calibers: ['65-prc', '300-win-mag', '300-prc', '7mm-rem-mag', '280-ackley-improved'],
    description: 'When you need to reach past 1,000 yards, you need more case capacity to push high-BC bullets fast enough to remain supersonic. These magnums and magnum-class cartridges deliver the velocity needed for reliable hits at extreme range.',
  },
  {
    title: 'Best for ELR (1,500+ Yards)',
    calibers: ['338-lapua-magnum', '300-norma-magnum', '33-nosler', '50-bmg', '408-cheytac'],
    description: 'Extreme Long Range requires large-case cartridges pushing very heavy, high-BC projectiles. At these distances, the .338 Lapua Magnum is the gold standard — proven in both military and competition ELR applications.',
  },
  {
    title: 'Best for PRS/NRL Competition',
    calibers: ['6mm-creedmoor', '65-creedmoor', '6mm-arc', '65-prc', '308-winchester'],
    description: 'Precision Rifle Series and National Rifle League competition demands speed, accuracy, and the ability to spot your own impacts. Low-recoil, high-BC cartridges dominate: 6mm Creedmoor for Gas Gun and 6.5 Creedmoor for bolt-action divisions.',
  },
  {
    title: 'Best Budget Long-Range',
    calibers: ['308-winchester', '65-creedmoor', '223-remington', '65-grendel', '762x54mmr'],
    description: 'You don\'t need a magnum to shoot long range. These calibers offer the cheapest path to 600+ yard precision: affordable rifles, inexpensive match ammo, and forgiving recoil that lets you practice more for less.',
  },
];

const pageDescription = 'Best calibers for long-range shooting in 2026 — from 500-yard precision to ELR past 1,500 yards. Covers PRS competition, hunting, and budget options with ballistic data.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    { '@type': 'Question', 'name': 'What is the best caliber for long-range shooting?', 'acceptedAnswer': { '@type': 'Answer', 'text': '6.5 Creedmoor is the best all-around long-range caliber for most shooters. It offers an exceptional combination of high ballistic coefficient, low recoil, long barrel life, and widely available match ammunition. For ranges past 1,000 yards, step up to 6.5 PRC or .300 Win Mag.' } },
    { '@type': 'Question', 'name': 'What caliber do snipers use?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Most military snipers use .308 Winchester (7.62 NATO) for engagements under 800 yards and .338 Lapua Magnum for extended range. The U.S. military has adopted the 6.5 Creedmoor for some SOCOM precision roles and the .300 Norma Magnum in the Barrett MRAD (Mk 22 ASR).' } },
    { '@type': 'Question', 'name': 'How far can a 6.5 Creedmoor shoot accurately?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'A skilled shooter with a quality rifle and match ammunition can consistently hit targets at 1,000 yards with 6.5 Creedmoor. The 140gr ELD Match remains supersonic past 1,300 yards. Practical accuracy depends more on the shooter, optics, and conditions than the cartridge.' } },
    { '@type': 'Question', 'name': 'Is .308 Winchester good for long-range?', 'acceptedAnswer': { '@type': 'Answer', 'text': '.308 Winchester is effective to 800 yards and capable to 1,000 with 175gr match loads. While 6.5 Creedmoor has surpassed it ballistically, .308 remains excellent for budget long-range due to cheap surplus ammo, ubiquitous rifle availability, and proven accuracy.' } },
  ],
};
---

<BaseLayout title="Best Calibers for Long-Range Shooting (2026)" description={pageDescription} breadcrumbs={[{ label: 'Best Long-Range Calibers' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Best Calibers for Long-Range Shooting
      </h1>
      <p class="mt-3 font-mono text-base text-text-muted max-w-3xl">
        From 500-yard precision to ELR past 1,500 yards. Five categories covering PRS competition, military sniping, hunting, and budget options — all backed by ballistic data from our 102-caliber database.
      </p>
    </div>

    {tiers.map(tier => {
      const cals = tier.calibers.map(slug => bySlug.get(slug)).filter(Boolean);
      return (
        <section class="mb-10">
          <h2 class="mb-2 font-display text-xl font-semibold tracking-[0.15em] uppercase text-accent border-b border-surface-border pb-3">
            {tier.title}
          </h2>
          <p class="mb-4 font-mono text-sm text-text-muted">{tier.description}</p>
          <div class="border border-surface-border overflow-x-auto" tabindex="0" role="region" aria-label={tier.title}>
            <table class="w-full text-left font-mono">
              <thead>
                <tr class="border-b border-surface-border bg-surface-overlay text-text-muted">
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs">Caliber</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Velocity</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Eff. Range</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Recoil</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-right">Cost/Rd</th>
                  <th scope="col" class="px-3 py-2 font-medium tracking-wider uppercase text-xs text-center">Avail.</th>
                </tr>
              </thead>
              <tbody>
                {cals.map((c, i) => (
                  <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                    <td class="px-3 py-2">
                      <a href={`/caliber-companion/calibers/${c!.slug}`} class="text-sm font-medium text-text-primary hover:text-accent transition-colors">{c!.name}</a>
                    </td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtRange(c!.typical_velocity_fps, 'fps')}</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{fmtNumber(c!.effective_range_yd)} yd</td>
                    <td class="px-3 py-2 text-sm text-right text-text-secondary">{c!.recoil.free_recoil_ft_lbs} ft·lbs</td>
                    <td class="px-3 py-2 text-sm text-right text-text-muted">{fmtCurrency(c!.cost_per_round_usd)}</td>
                    <td class="px-3 py-2 text-sm text-center text-text-muted">{c!.availability_rating ?? '—'}/5</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}

    <!-- FAQ -->
    <section class="mt-12 border-t border-surface-border pt-8">
      <h2 class="font-display text-xl font-semibold tracking-[0.2em] uppercase text-text-muted mb-4">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          { q: 'What is the best long-range caliber for beginners?', a: '6.5 Creedmoor in a Ruger Precision Rifle or Bergara B-14 HMR. The combination of low recoil, excellent factory match ammo (Hornady ELD Match), and gentle recoil lets new shooters develop fundamentals without flinching. Budget about $0.80-1.50/round for match ammo.' },
          { q: '6.5 Creedmoor vs .308 Winchester for long range?', a: 'The 6.5 Creedmoor wins on trajectory, wind drift, and retained energy past 500 yards thanks to higher-BC bullets. The .308 Winchester wins on ammunition cost (especially surplus), barrel life, and ubiquity. For serious long-range work, 6.5 CM. For budget plinking at distance, .308.' },
          { q: 'What is the best caliber for 1,000+ yards?', a: 'For target shooting at 1,000 yards: 6.5 Creedmoor or 6.5 PRC. For hunting at 1,000+ yards: .300 Win Mag or .300 PRC for adequate terminal energy. For competition ELR past 1,500 yards: .338 Lapua Magnum or .300 Norma Magnum.' },
          { q: 'How much does it cost to get into long-range shooting?', a: 'Entry-level: $1,500-2,500 (Ruger American/Howa 1500 + Vortex Diamondback). Mid-range: $2,500-4,000 (Bergara/Tikka + Vortex PST Gen II). Competition-ready: $4,000-8,000+ (custom action + premium scope). Budget 500+ rounds of match ammo for initial training.' },
        ].map(faq => (
          <details class="group border border-surface-border">
            <summary class="flex cursor-pointer items-center justify-between bg-surface-raised px-4 py-3 font-mono text-sm text-text-primary transition-colors hover:bg-surface-overlay">
              <span>{faq.q}</span>
              <svg class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-surface-border-subtle bg-surface px-4 py-3">
              <p class="font-mono text-sm text-text-secondary leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-8 flex flex-wrap gap-3 border-t border-surface-border pt-6">
      <span class="font-mono text-xs tracking-wider uppercase text-text-muted self-center">Related:</span>
      <a href="/caliber-companion/guides/best-calibers-for-long-range-precision" class="font-mono text-sm text-accent hover:underline">Long-Range Precision Guide</a>
      <a href="/caliber-companion/guides/best-calibers-for-prs-competition" class="font-mono text-sm text-accent hover:underline">PRS Competition Guide</a>
      <a href="/caliber-companion/tools/drop-chart" class="font-mono text-sm text-accent hover:underline">Bullet Drop Chart</a>
      <a href="/caliber-companion/tools/bc-estimator" class="font-mono text-sm text-accent hover:underline">BC Estimator</a>
      <a href="/caliber-companion/tools/ethical-range" class="font-mono text-sm text-accent hover:underline">Ethical Range Calculator</a>
    </div>
  </div>
</BaseLayout>
