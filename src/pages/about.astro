---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');
const firearms = await getCollection('firearmsData');
const guides = await getCollection('guides');

const totalLoads = calibers.reduce((sum, c) => sum + c.data.loads.length, 0);
const categories = [...new Set(calibers.map(c => c.data.category))];
const totalGameRecs = calibers.reduce((sum, c) => sum + (c.data.recommended_game?.length ?? 0), 0);
const totalGelLoads = calibers.reduce((sum, c) => sum + c.data.loads.filter(l => l.gel_penetration_in).length, 0);
const withReloading = calibers.filter(c => c.data.primer_type).length;
const firearmsManufacturers = [...new Set(firearms.map(f => f.data.manufacturer))].length;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { value: calibers.length, label: 'Calibers', desc: 'From .17 HMR to .50 BMG' },
  { value: totalLoads, label: 'Load Profiles', desc: 'With full ballistic trajectories' },
  { value: firearms.length, label: 'Firearms', desc: `From ${firearmsManufacturers} manufacturers` },
  { value: guides.length, label: 'Buying Guides', desc: 'For every major use case' },
  { value: '10', label: 'Interactive Tools', desc: 'Calculators and generators' },
  { value: '48', label: 'Comparison Pages', desc: 'Side-by-side matchups' },
  { value: totalGelLoads, label: 'Gel Test Results', desc: 'FBI protocol terminal data' },
  { value: totalGameRecs, label: 'Game Recommendations', desc: 'Species-specific advice' },
  { value: categories.length, label: 'Categories', desc: 'Handgun to magnum rifle' },
  { value: withReloading, label: 'Reloading Specs', desc: 'Primer, pressure, powder' },
  { value: '5', label: 'SEO Landing Pages', desc: 'Deer, defense, long-range, home, beginners' },
  { value: '102', label: 'Prose Articles', desc: 'Detailed caliber descriptions' },
];
---

<BaseLayout title="About Caliber Companion" description="About Caliber Companion — the most comprehensive free firearm caliber reference online. Site statistics, features, and what makes this resource unique." breadcrumbs={[{ label: 'About' }]} jsonLd={{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Caliber Companion',
  url: 'https://rwev.github.io/caliber-companion/',
  description: 'The most comprehensive free firearm caliber reference online. Ballistic data, cartridge specifications, and comparison tools.',
  logo: 'https://rwev.github.io/caliber-companion/favicon.svg',
}}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        About Caliber Companion
      </h1>
      <p class="mt-3 text-base text-text-muted max-w-3xl">
        The most comprehensive free firearm caliber reference online. Every data point, tool, and recommendation
        is built from real ballistic data — no opinions without numbers, no recommendations without evidence.
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="mb-12 grid gap-px bg-surface-border grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 rounded-lg overflow-hidden">
      {stats.map(stat => (
        <div class="bg-surface p-5 text-center">
          <div class="font-mono text-3xl font-bold text-accent">{stat.value}</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-text-primary">{stat.label}</div>
          <div class="mt-0.5 text-xs text-text-muted">{stat.desc}</div>
        </div>
      ))}
    </div>

    <!-- What Makes This Different -->
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold text-accent border-b border-surface-border pb-3">
        What Makes This Different
      </h2>
      <div class="space-y-4 text-sm text-text-secondary leading-relaxed">
        <p>
          <strong class="text-text-primary">Data-driven, not opinion-driven.</strong> Every caliber page shows real
          ballistic trajectories, measured recoil energy, actual ammunition costs, and FBI-protocol gel test results
          where available. Recommendations are backed by numbers you can verify.
        </p>
        <p>
          <strong class="text-text-primary">Completely static and private.</strong> No accounts, no tracking, no ads,
          no external API calls. The entire site is pre-built HTML/CSS/JS that loads instantly and works offline
          as a Progressive Web App. Your browsing history stays on your device.
        </p>
        <p>
          <strong class="text-text-primary">Free and open.</strong> No paywalls, no premium tiers, no gated content.
          Every tool, every data point, every comparison is freely accessible. If you find it useful,
          consider supporting the site through the donation link in the footer.
        </p>
        <p>
          <strong class="text-text-primary">10 interactive tools.</strong> Ballistics calculator with atmospheric
          corrections, recoil calculator, ammunition cost planner, printable range cards, cartridge overlay,
          bullet drop comparison charts, BC estimator, ethical range calculator, and range day planner.
          All run locally in your browser — no server required.
        </p>
      </div>
    </section>

    <!-- Features List -->
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold text-accent border-b border-surface-border pb-3">
        Features
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {[
          'Radar profile charts on every caliber page',
          'Procedural SVG cartridge dimension diagrams',
          'Cartridge family tree with parent-child lineage',
          'Interactive scatter plot on browse page',
          'Historical timeline from 1800 to 2024',
          'Use case suitability heatmap (caliber × purpose)',
          'Cost-per-round comparison dot plot',
          'Recoil ranking with color-coded bar chart',
          'Terminal performance gel penetration comparison',
          'FAQ schema for Google rich results',
          'BreadcrumbList schema for navigation',
          'Print-friendly stylesheet for range reference',
          'PWA for offline access at the range',
          'Favorites and recently viewed (localStorage)',
          'Share button with Web Share API',
          'State hunting regulation reference',
          'NATO vs civilian caliber equivalents',
          'Caliber myths debunked with data',
        ].map(feature => (
          <div class="flex items-start gap-2 text-sm text-text-secondary">
            <svg class="h-4 w-4 mt-0.5 shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            {feature}
          </div>
        ))}
      </div>
    </section>

    <!-- Explore CTA -->
    <div class="text-center border-t border-surface-border pt-8">
      <a
        href={`${base}/calibers`}
        class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent/10 px-6 py-3 text-base font-medium text-accent transition-all hover:bg-accent/20"
      >
        Start Exploring
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</BaseLayout>
