---
import BaseLayout from '../layouts/BaseLayout.astro';
import FavoritesList from '../components/islands/FavoritesList';
import RecentlyViewed from '../components/islands/RecentlyViewed';
import NewsletterSignup from '../components/islands/NewsletterSignup';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');
const categories = [...new Set(calibers.map(c => c.data.category))];

// Featured: most widely adopted military calibers
const featuredSlugs = [
  '9mm-luger',         // NATO standard sidearm
  '556x45mm-nato',     // NATO standard rifle
  '308-winchester',    // 7.62 NATO — GPMGs, battle rifles, sniper
  '762x39mm',          // AK-47/AKM — most produced rifle cartridge
  '12-gauge',          // Military breaching, close quarters
  '50-bmg',            // Heavy machine guns, anti-materiel
];
const featured = featuredSlugs
  .map(slug => calibers.find(c => c.data.slug === slug))
  .filter(Boolean);

const caliberIndex = calibers.map(c => ({
  slug: c.data.slug,
  name: c.data.name,
  designation: c.data.designation,
  category: c.data.category,
}));
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:py-40">
      <div class="max-w-3xl">
        <!-- Category count tag -->
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-accent/10 px-3 py-1">
          <span class="text-sm font-medium text-accent">
            {calibers.length} Calibers · {categories.length} Categories
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-5xl font-bold tracking-tight text-text-primary sm:text-6xl lg:text-7xl">
          <span class="block">Caliber</span>
          <span class="block text-accent">Companion</span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-secondary sm:text-xl">
          Research, compare, and understand firearm calibers.
          Detailed ballistic data, cartridge specifications, and
          side-by-side comparison tools.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/calibers"
            class="group inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-base font-semibold text-white shadow-sm transition-all hover:bg-accent-bright"
          >
            <span>Browse Calibers</span>
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/compare"
            class="inline-flex items-center gap-2 rounded-md border border-surface-border px-5 py-2.5 text-base font-semibold text-text-secondary transition-all hover:border-accent/40 hover:text-text-primary"
          >
            <span>Compare</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="border-y border-surface-border bg-surface-raised/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-2 divide-x divide-surface-border sm:grid-cols-4">
        {[
          { value: `${calibers.length}`, label: 'Calibers' },
          { value: `${calibers.reduce((sum, c) => sum + c.data.loads.length, 0)}`, label: 'Load Profiles' },
          { value: 'Full', label: 'Ballistic Tables' },
          { value: 'Side×Side', label: 'Comparison Tool' },
        ].map(stat => (
          <div class="px-4 py-6 text-center sm:px-6 sm:py-8">
            <div class="text-2xl font-bold text-accent sm:text-3xl">{stat.value}</div>
            <div class="mt-1 text-sm font-medium text-text-muted">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recently Viewed (client-side, renders only if user has history) -->
  <RecentlyViewed client:idle allCalibers={caliberIndex} basePath="" />

  <!-- Saved Calibers (client-side, renders only if user has favorites) -->
  <FavoritesList client:idle allCalibers={caliberIndex} basePath="" />

  <!-- Featured Calibers Preview -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-8 flex items-center gap-4">
      <div class="h-px flex-1 bg-surface-border" aria-hidden="true"></div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted">Military Standard Calibers</h2>
      <div class="h-px flex-1 bg-surface-border" aria-hidden="true"></div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map(caliber => (
        <a
          href={`/calibers/${caliber.data.slug}`}
          class="group rounded-lg border border-surface-border bg-surface p-6 transition-all hover:border-accent/40 hover:bg-surface-raised hover:shadow-md"
        >
          <div class="flex items-start justify-between">
            <div>
              <div class="text-xl font-semibold text-text-primary group-hover:text-accent transition-colors">
                {caliber.data.name}
              </div>
              <div class="mt-0.5 font-mono text-sm text-text-muted">
                {caliber.data.designation}
              </div>
            </div>
            <span class="mt-1 rounded-full bg-surface-overlay px-2.5 py-0.5 text-xs font-medium text-text-muted">
              {caliber.data.category.replace('_', ' ')}
            </span>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-3">
            <div>
              <div class="text-xs font-medium uppercase tracking-wide text-text-muted">Velocity</div>
              <div class="mt-0.5 font-mono text-base text-text-secondary">
                {caliber.data.typical_velocity_fps[0]}–{caliber.data.typical_velocity_fps[1]} <span class="text-text-muted text-sm">fps</span>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase tracking-wide text-text-muted">Energy</div>
              <div class="mt-0.5 font-mono text-base text-text-secondary">
                {caliber.data.typical_energy_ft_lbs[0]}–{caliber.data.typical_energy_ft_lbs[1]} <span class="text-text-muted text-sm">ft·lbs</span>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase tracking-wide text-text-muted">Range</div>
              <div class="mt-0.5 font-mono text-base text-text-secondary">
                {caliber.data.effective_range_yd} <span class="text-text-muted text-sm">yd</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href="/calibers"
        class="text-sm font-medium text-text-muted transition-colors hover:text-accent"
      >
        View all calibers →
      </a>
    </div>
  </section>

  <!-- Explore by Section -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-8 flex items-center gap-4">
      <div class="h-px flex-1 bg-surface-border" aria-hidden="true"></div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted">Explore</h2>
      <div class="h-px flex-1 bg-surface-border" aria-hidden="true"></div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {[
        {
          href: '/calibers',
          title: 'Calibers',
          desc: `Browse and research ${calibers.length} calibers with detailed ballistic data, specs, and ${calibers.reduce((s, c) => s + c.data.loads.length, 0)} load profiles.`,
          icon: 'M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z',
          links: [
            { href: '/calibers', label: 'Browse All' },
            { href: '/calibers/ammo', label: 'Ammo Finder' },
          ],
        },
        {
          href: '/compare',
          title: 'Compare',
          desc: 'Side-by-side caliber comparisons with 48 pre-built head-to-head matchups and a custom comparison tool.',
          icon: 'M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5',
          links: [
            { href: '/compare', label: 'Compare Tool' },
          ],
        },
        {
          href: '/tools',
          title: 'Tools',
          desc: '9 interactive calculators for ballistics, recoil, ammo cost, range cards, and more.',
          icon: 'M11.42 15.17l-5.648-3.064a.64.64 0 01-.229-1.015l4.217-6.278a.75.75 0 011.259 0l4.217 6.278a.75.75 0 01-.229 1.015L9.42 15.17z',
          links: [
            { href: '/tools/ballistics-calculator', label: 'Ballistics Calc' },
            { href: '/tools/recoil-calculator', label: 'Recoil Calc' },
            { href: '/tools', label: 'All Tools' },
          ],
        },
        {
          href: '/guides',
          title: 'Guides',
          desc: 'Expert caliber recommendations for hunting, self-defense, home defense, long-range, and beginners.',
          icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
          links: [
            { href: '/guides/best-deer-calibers', label: 'Best for Deer' },
            { href: '/guides/best-self-defense-calibers', label: 'Self-Defense' },
            { href: '/guides/quiz', label: 'Find Your Caliber' },
            { href: '/guides', label: 'All Guides' },
          ],
        },
        {
          href: '/reference',
          title: 'Reference',
          desc: 'Glossary, timeline, firearms database, NATO equivalents, reloading data, hunting regulations, and more.',
          icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
          links: [
            { href: '/reference/glossary', label: 'Glossary' },
            { href: '/reference/timeline', label: 'Timeline' },
            { href: '/reference/firearms', label: 'Firearms' },
            { href: '/reference', label: 'All Reference' },
          ],
        },
      ].map(section => (
        <a
          href={section.href}
          class="group rounded-lg border border-surface-border bg-surface p-6 transition-all hover:border-accent/40 hover:bg-surface-raised hover:shadow-md"
        >
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-accent/30 bg-accent/10 text-accent">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={section.icon} />
              </svg>
            </div>
            <div class="min-w-0">
              <h3 class="text-xl font-semibold text-text-primary group-hover:text-accent transition-colors">
                {section.title}
              </h3>
              <p class="mt-1 text-sm text-text-muted leading-relaxed">{section.desc}</p>
              <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
                {section.links.map(link => (
                  <span class="text-xs font-medium text-accent">{link.label}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="border-t border-surface-border bg-surface-raised/50">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16 text-center">
      <div class="mb-2 flex items-center justify-center gap-2">
        <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted">Stay Updated</h2>
      </div>
      <p class="mb-6 text-sm text-text-muted">
        New caliber data, tool updates, and guides — no spam, unsubscribe anytime.
      </p>
      <NewsletterSignup client:idle />
    </div>
  </section>
</BaseLayout>
