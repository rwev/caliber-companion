---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BallisticsCalculator from '../../components/islands/BallisticsCalculator';
---

<BaseLayout title="Ballistics Calculator" description="Interactive ballistics calculator with trajectory, wind drift, energy retention, and MOA corrections.">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Ballistics Calculator
      </h1>
      <p class="mt-2 font-mono text-base text-text-muted">
        Point mass trajectory calculator with wind drift, drop in MOA, and atmospheric corrections. Enter your load data to generate a complete trajectory table and chart.
      </p>
      <p class="mt-2 font-mono text-xs text-text-muted">
        Default values: 6.5 Creedmoor 140gr ELD Match · 100 yd zero · 10 mph crosswind · sea level standard atmosphere
      </p>
    </div>

    <BallisticsCalculator client:load />
  </div>
</BaseLayout>
