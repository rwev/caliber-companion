---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EthicalRangeCalculator from '../../components/islands/EthicalRangeCalculator';
import { getCollection } from 'astro:content';

const allCalibers = await getCollection('caliberData');
const caliberEntries = allCalibers
  .map(c => ({
    name: c.data.name,
    slug: c.data.slug,
    loads: c.data.loads.map(l => ({
      name: l.name,
      bullet_weight_gr: l.bullet_weight_gr,
      bullet_type: l.bullet_type,
      muzzle_velocity_fps: l.muzzle_velocity_fps,
      muzzle_energy_ft_lbs: l.muzzle_energy_ft_lbs,
      ballistics: l.ballistics,
    })),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Ethical Range Calculator" description="Determine maximum ethical killing distances for different game animals based on your caliber and load's energy at range." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Ethical Range' }]}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Ethical Range Calculator
      </h1>
      <p class="mt-2 text-base text-text-muted max-w-2xl">
        Select your caliber and load to see estimated maximum ethical killing distances for 10 game categories — from varmints to dangerous game. Based on minimum energy thresholds at range.
      </p>
    </div>

    <EthicalRangeCalculator client:idle calibers={caliberEntries} />
  </div>
</BaseLayout>
