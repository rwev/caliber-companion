---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BCEstimator from '../../components/islands/BCEstimator';
---

<BaseLayout title="Ballistic Coefficient Estimator" description="Estimate G1 and G7 ballistic coefficients from bullet weight, diameter, and shape. Includes form factor reference table for common bullet types." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'BC Estimator' }]}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Ballistic Coefficient Estimator
      </h1>
      <p class="mt-2 text-base text-text-muted max-w-2xl">
        Estimate G1 and G7 ballistic coefficients from bullet weight, diameter, and shape using the form factor method. Useful for handloaders working with bullets that don't have published BC data.
      </p>
    </div>

    <BCEstimator client:idle />
  </div>
</BaseLayout>
