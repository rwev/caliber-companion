---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CartridgeOverlay from '../../components/islands/CartridgeOverlay';
import { getCollection } from 'astro:content';

const allCalibers = await getCollection('caliberData');
const caliberDims = allCalibers
  .map(c => ({
    name: c.data.name,
    slug: c.data.slug,
    dimensions: c.data.dimensions,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Cartridge Size Overlay" description="Compare cartridge dimensions side-by-side. Overlay 2-6 cartridge profiles at true scale to visualize size differences." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Cartridge Overlay' }]}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Cartridge Size Overlay
      </h1>
      <p class="mt-2 text-base text-text-muted max-w-2xl">
        Overlay up to 6 cartridge profiles at true proportional scale. See exactly how cartridges compare in size — from tiny .22 LR to massive .50 BMG.
      </p>
    </div>

    <CartridgeOverlay client:idle calibers={caliberDims} />
  </div>
</BaseLayout>
