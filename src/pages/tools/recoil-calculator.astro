---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecoilCalculator from '../../components/islands/RecoilCalculator';
---

<BaseLayout title="Recoil Calculator" description="Calculate free recoil energy, recoil velocity, and impulse for any firearm and load combination. Compare recoil across 12 common calibers." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Recoil Calculator' }]}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Recoil Calculator
      </h1>
      <p class="mt-2 text-base text-text-muted">
        Compute free recoil energy, velocity, and impulse for any firearm and load. Select a preset or enter custom values.
      </p>
      <p class="mt-2 font-mono text-xs text-text-muted">
        Default values: .308 Winchester 168gr BTHP · Remington 700 (8.5 lbs) · 44gr powder charge
      </p>
    </div>

    <RecoilCalculator client:load />
  </div>
</BaseLayout>
