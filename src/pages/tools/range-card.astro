---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RangeCardGenerator from '../../components/islands/RangeCardGenerator';
import { getCollection } from 'astro:content';

const allCalibers = await getCollection('caliberData');
const caliberEntries = allCalibers
  .map(c => ({
    name: c.data.name,
    slug: c.data.slug,
    designation: c.data.designation,
    effective_range_yd: c.data.effective_range_yd,
    loads: c.data.loads.map(l => ({
      name: l.name,
      bullet_weight_gr: l.bullet_weight_gr,
      bullet_type: l.bullet_type,
      muzzle_velocity_fps: l.muzzle_velocity_fps,
      muzzle_energy_ft_lbs: l.muzzle_energy_ft_lbs,
      barrel_length_in: l.barrel_length_in,
      bc_g1: l.bc_g1,
      ballistics: l.ballistics,
    })),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Range Card Generator" description="Generate printable range cards with trajectory data for any caliber and load. Select your caliber, choose a load, set your zero, and print." breadcrumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Range Card' }]}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Range Card Generator
      </h1>
      <p class="mt-2 text-base text-text-muted max-w-2xl">
        Generate a printable range card for any caliber and load. Choose your zero distance, add notes about your setup, and print for the range.
      </p>
    </div>

    <RangeCardGenerator client:idle calibers={caliberEntries} />
  </div>
</BaseLayout>
