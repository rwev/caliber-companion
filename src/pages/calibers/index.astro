---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/islands/FilterBar';
import CaliberScatterPlot from '../../components/islands/CaliberScatterPlot';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');

const caliberSummaries = calibers.map(c => ({
  name: c.data.name,
  designation: c.data.designation,
  slug: c.data.slug,
  category: c.data.category,
  aliases: c.data.aliases,
  typical_velocity_fps: c.data.typical_velocity_fps,
  typical_energy_ft_lbs: c.data.typical_energy_ft_lbs,
  effective_range_yd: c.data.effective_range_yd,
  popularity_tier: c.data.popularity_tier,
  recoil_subjective: c.data.recoil.subjective,
  year_introduced: c.data.year_introduced,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Browse Calibers',
  description: 'Browse, search, filter, and visualize firearm calibers by category, performance, recoil, and cost.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: calibers.length,
    itemListElement: calibers.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.data.name,
      url: `https://rwev.github.io/calibers/${c.data.slug}`,
    })),
  },
};

const scatterPoints = calibers.map(c => ({
  name: c.data.name,
  slug: c.data.slug,
  category: c.data.category,
  typical_energy_ft_lbs: c.data.typical_energy_ft_lbs,
  typical_velocity_fps: c.data.typical_velocity_fps,
  effective_range_yd: c.data.effective_range_yd,
  recoil_ft_lbs: c.data.recoil.free_recoil_ft_lbs,
  cost_per_round: (c.data.cost_per_round_usd[0] + c.data.cost_per_round_usd[1]) / 2,
  year_introduced: c.data.year_introduced,
}));
---

<BaseLayout breadcrumbs={[{ label: 'Calibers' }]} title="Browse Calibers" description="Browse, search, filter, and visualize 100 firearm calibers by category, performance, recoil, and cost." jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Browse Calibers
      </h1>
      <p class="mt-2 text-base text-text-muted">
        {calibers.length} calibers · search, filter, sort, and visualize
      </p>
    </div>

    <CaliberScatterPlot client:visible calibers={scatterPoints} basePath="" />

    <FilterBar client:idle calibers={caliberSummaries} basePath="" />
  </div>
</BaseLayout>
