---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import UsageBadges from '../../components/UsageBadges.astro';
import AdoptionTimeline from '../../components/AdoptionTimeline.astro';
import CartridgeLineage from '../../components/CartridgeLineage.astro';
import BallisticsChart from '../../components/islands/BallisticsChart';
import CartridgeDiagram from '../../components/islands/CartridgeDiagram';
import CaliberRadarChart from '../../components/islands/CaliberRadarChart';
import FavoriteButton from '../../components/islands/FavoriteButton';
import { getCollection, render } from 'astro:content';
import { fmtRange, fmtNumber, fmtCurrency, titleCase } from '../../lib/format';

export async function getStaticPaths() {
  const calibers = await getCollection('caliberData');
  return calibers.map(caliber => ({
    params: { slug: caliber.data.slug },
    props: { caliber },
  }));
}

const { caliber } = Astro.props;
const d = caliber.data;

// Find matching prose
const proseEntries = await getCollection('caliberProse');
const prose = proseEntries.find(p => p.data.slug === d.slug);
const rendered = prose ? await render(prose) : null;
const Content = rendered?.Content;

// Find firearms for this caliber
const allFirearms = await getCollection('firearmsData');
const linkedFirearms = allFirearms
  .filter(f => f.data.caliber === d.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

// Resolve cartridge lineage
const allCalibers = await getCollection('caliberData');
const caliberBySlug = new Map(allCalibers.map(c => [c.data.slug, c.data]));

const parentRef = d.parent_cartridge
  ? { slug: d.parent_cartridge, name: caliberBySlug.get(d.parent_cartridge)?.name ?? d.parent_cartridge }
  : undefined;

const childRefs = (d.derived_cartridges ?? [])
  .map(slug => ({ slug, name: caliberBySlug.get(slug)?.name ?? slug }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Compute related calibers by similarity
const relatedCalibers = allCalibers
  .filter(c => c.data.slug !== d.slug)
  .map(c => {
    const other = c.data;
    let score = 0;

    // Same category bonus
    if (other.category === d.category) score += 20;

    // Overlapping use cases
    const sharedUses = d.primary_use_cases.filter(u => other.primary_use_cases.includes(u)).length;
    score += sharedUses * 8;

    // Similar effective range (within 30%)
    const rangeDiff = Math.abs(other.effective_range_yd - d.effective_range_yd) / Math.max(d.effective_range_yd, 1);
    if (rangeDiff < 0.15) score += 15;
    else if (rangeDiff < 0.30) score += 8;
    else if (rangeDiff < 0.50) score += 3;

    // Similar energy envelope (within 30%)
    const avgEnergy = (d.typical_energy_ft_lbs[0] + d.typical_energy_ft_lbs[1]) / 2;
    const otherAvgEnergy = (other.typical_energy_ft_lbs[0] + other.typical_energy_ft_lbs[1]) / 2;
    const energyDiff = Math.abs(otherAvgEnergy - avgEnergy) / Math.max(avgEnergy, 1);
    if (energyDiff < 0.15) score += 12;
    else if (energyDiff < 0.30) score += 6;

    // Same popularity tier bonus
    if (other.popularity_tier === d.popularity_tier) score += 5;

    // Penalize same lineage (parent/child already shown)
    if (d.parent_cartridge === other.slug || d.derived_cartridges?.includes(other.slug)) score -= 30;

    return { slug: other.slug, name: other.name, category: other.category, score };
  })
  .filter(c => c.score > 15)
  .sort((a, b) => b.score - a.score)
  .slice(0, 5);

const dimensionRows = [
  { label: 'Bullet Diameter', value: `${d.dimensions.bullet_diameter_in}" (${(d.dimensions.bullet_diameter_in * 25.4).toFixed(2)}mm)` },
  { label: 'Neck Diameter', value: `${d.dimensions.neck_diameter_in}"` },
  { label: 'Case Length', value: `${d.dimensions.case_length_in}"` },
  { label: 'Overall Length', value: `${d.dimensions.overall_length_in}"` },
  ...(d.dimensions.rim_diameter_in ? [{ label: 'Rim Diameter', value: `${d.dimensions.rim_diameter_in}"` }] : []),
  { label: 'Case Type', value: d.dimensions.case_type },
];

const performanceRows = [
  { label: 'Typical Velocity', value: fmtRange(d.typical_velocity_fps, 'fps') },
  { label: 'Typical Energy', value: fmtRange(d.typical_energy_ft_lbs, 'ft·lbs') },
  { label: 'Bullet Weight', value: fmtRange(d.typical_bullet_weight_gr, 'gr') },
  { label: 'Effective Range', value: `${fmtNumber(d.effective_range_yd)} yd` },
  ...(d.max_range_yd ? [{ label: 'Max Range', value: `${fmtNumber(d.max_range_yd)} yd` }] : []),
];

const recoilRows = [
  { label: 'Free Recoil Energy', value: `${d.recoil.free_recoil_ft_lbs} ft·lbs` },
  { label: 'Reference Firearm', value: d.recoil.reference_firearm },
  { label: 'Subjective Rating', value: titleCase(d.recoil.subjective) },
];

const availabilityLabels: Record<number, string> = { 1: '1/5 — Very Scarce', 2: '2/5 — Limited', 3: '3/5 — Moderate', 4: '4/5 — Widely Available', 5: '5/5 — Everywhere' };

const marketRows = [
  { label: 'Popularity', value: titleCase(d.popularity_tier) },
  { label: 'Cost Per Round', value: fmtCurrency(d.cost_per_round_usd) },
  ...(d.availability_rating ? [{ label: 'Availability', value: availabilityLabels[d.availability_rating] || `${d.availability_rating}/5` }] : []),
  ...(d.price_trend ? [{ label: 'Price Trend', value: titleCase(d.price_trend) }] : []),
  ...(d.annual_production_estimate ? [{ label: 'Production Volume', value: titleCase(d.annual_production_estimate) }] : []),
  ...(d.suppressor_friendly !== undefined ? [{ label: 'Suppressor Friendly', value: d.suppressor_friendly ? 'Yes' : 'No' }] : []),
  ...(d.subsonic_loads_available !== undefined ? [{ label: 'Subsonic Loads', value: d.subsonic_loads_available ? 'Available' : 'Not Common' }] : []),
  { label: 'Year Introduced', value: `${d.year_introduced}` },
  { label: 'Country of Origin', value: d.country_of_origin },
];

const caliberDescription = prose?.data.summary || `${d.name} (${d.designation}) — ${titleCase(d.category)} cartridge. Effective range: ${d.effective_range_yd} yd. Year introduced: ${d.year_introduced}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'name': d.name,
  'headline': `${d.name} — Caliber Specifications, Ballistics & History`,
  'description': caliberDescription,
  'dateModified': prose?.data.last_updated?.toISOString() || '2026-03-22',
  'publisher': {
    '@type': 'Organization',
    'name': 'Caliber Companion',
  },
  'mainEntityOfPage': `https://rwev.github.io/caliber-companion/calibers/${d.slug}`,
};

const reloadingRows = [
  ...(d.max_pressure_psi ? [{ label: 'Max Pressure (SAAMI)', value: `${fmtNumber(d.max_pressure_psi)} psi` }] : []),
  ...(d.primer_type ? [{ label: 'Primer Type', value: d.primer_type }] : []),
  ...(d.powder_charge_range_gr ? [{ label: 'Typical Charge', value: fmtRange(d.powder_charge_range_gr, 'gr') }] : []),
];
---

<BaseLayout title={d.name} description={caliberDescription} ogType="article" jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 border-b border-surface-border pb-6">
      <div class="flex items-center gap-3 mb-2">
        <a href="/caliber-companion/browse" class="font-mono text-sm tracking-wider uppercase text-text-muted hover:text-accent transition-colors">
          ← All Calibers
        </a>
        <span class="text-text-muted">·</span>
        <span class="border border-accent/30 bg-accent/10 px-2 py-0.5 font-mono text-sm tracking-wider uppercase text-accent">
          {titleCase(d.category)}
        </span>
      </div>

      <div class="flex items-start justify-between gap-4">
        <h1 class="font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
          {d.name}
        </h1>
        <FavoriteButton client:idle slug={d.slug} name={d.name} />
      </div>
      <div class="mt-1 font-mono text-base text-text-muted">
        {d.designation}
        {d.aliases.length > 0 && (
          <span class="text-text-muted"> · aka {d.aliases.join(', ')}</span>
        )}
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Left Column: Specs -->
      <div class="space-y-6 lg:col-span-2">
        <div class="grid gap-6 sm:grid-cols-2">
          <SpecTable title="Dimensions" rows={dimensionRows} />
          <SpecTable title="Performance" rows={performanceRows} />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <SpecTable title="Recoil" rows={recoilRows} />
          <SpecTable title="Market" rows={marketRows} />
        </div>

        {reloadingRows.length > 0 && (
          <SpecTable title="Reloading" rows={reloadingRows} />
        )}

        <!-- Loads Table -->
        <div class="border border-surface-border">
          <div class="border-b border-surface-border bg-surface-overlay px-4 py-2.5">
            <h3 class="font-display text-base tracking-[0.2em] uppercase text-text-muted">Load Profiles</h3>
          </div>

          {d.loads.map((load, loadIdx) => (
            <div class={loadIdx > 0 ? 'border-t border-surface-border' : ''}>
              <div class="flex items-baseline justify-between bg-surface-raised px-4 py-2.5">
                <span class="font-mono text-base font-medium text-text-primary">{load.name}</span>
                <span class="font-mono text-sm text-text-muted">
                  {load.bullet_weight_gr}gr {load.bullet_type} · {load.barrel_length_in}" barrel
                </span>
              </div>

              {(load.bc_g1 || load.bc_g7 || load.sectional_density || load.gel_penetration_in || load.expansion_diameter_in || load.barrier_blind !== undefined) && (
                <div class="flex flex-wrap gap-x-6 gap-y-1 px-4 py-2 bg-surface-overlay border-b border-surface-border-subtle">
                  {load.bc_g1 && (
                    <span class="font-mono text-sm text-text-secondary">
                      <span class="text-text-muted">BC (G1):</span> {load.bc_g1.toFixed(3)}
                    </span>
                  )}
                  {load.bc_g7 && (
                    <span class="font-mono text-sm text-text-secondary">
                      <span class="text-text-muted">BC (G7):</span> {load.bc_g7.toFixed(3)}
                    </span>
                  )}
                  {load.sectional_density && (
                    <span class="font-mono text-sm text-text-secondary">
                      <span class="text-text-muted">SD:</span> {load.sectional_density.toFixed(3)}
                    </span>
                  )}
                  {load.gel_penetration_in && (
                    <span class="font-mono text-sm text-text-secondary">
                      <span class="text-text-muted">Gel:</span> {load.gel_penetration_in}"
                    </span>
                  )}
                  {load.expansion_diameter_in && (
                    <span class="font-mono text-sm text-text-secondary">
                      <span class="text-text-muted">Exp:</span> {load.expansion_diameter_in}"
                    </span>
                  )}
                  {load.barrier_blind !== undefined && (
                    <span class={`font-mono text-sm ${load.barrier_blind ? 'text-success' : 'text-text-muted'}`}>
                      {load.barrier_blind ? '● Barrier Blind' : '○ Not Barrier Blind'}
                    </span>
                  )}
                </div>
              )}

              <div class="overflow-x-auto" tabindex="0" role="region" aria-label={`Ballistic data for ${load.name}`}>
                <table class="w-full text-left font-mono">
                  <thead>
                    <tr class="border-b border-surface-border-subtle bg-surface-overlay text-text-muted">
                      <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm">Distance</th>
                      <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-right">Velocity</th>
                      <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-right">Energy</th>
                      <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-right">Drop</th>
                    </tr>
                  </thead>
                  <tbody>
                    {load.ballistics.map((point, i) => (
                      <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                        <td class="px-4 py-2 text-base text-text-secondary">{point.distance_yd} yd</td>
                        <td class="px-4 py-2 text-right text-base text-text-primary">{fmtNumber(point.velocity_fps)} <span class="text-text-muted text-sm">fps</span></td>
                        <td class="px-4 py-2 text-right text-base text-text-primary">{fmtNumber(point.energy_ft_lbs)} <span class="text-text-muted text-sm">ft·lbs</span></td>
                        <td class={`px-4 py-2 text-right text-base ${point.drop_in < 0 ? 'text-danger' : 'text-text-primary'}`}>
                          {point.drop_in > 0 ? '+' : ''}{point.drop_in.toFixed(1)}"
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>

        <!-- Terminal Performance -->
        {d.loads.some(l => l.gel_penetration_in || l.expansion_diameter_in || l.barrier_blind !== undefined) && (
          <div class="border border-surface-border">
            <div class="border-b border-surface-border bg-surface-overlay px-4 py-2.5">
              <h3 class="font-display text-base tracking-[0.2em] uppercase text-text-muted">Terminal Performance</h3>
            </div>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Terminal ballistics data">
              <table class="w-full text-left font-mono">
                <thead>
                  <tr class="border-b border-surface-border-subtle bg-surface-overlay text-text-muted">
                    <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm">Load</th>
                    <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-right">Penetration</th>
                    <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-right">Expansion</th>
                    <th scope="col" class="px-4 py-2 font-medium tracking-wider uppercase text-sm text-center">Barrier</th>
                  </tr>
                </thead>
                <tbody>
                  {d.loads.filter(l => l.gel_penetration_in || l.expansion_diameter_in || l.barrier_blind !== undefined).map((load, i) => (
                    <tr class={`border-b border-surface-border-subtle ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                      <td class="px-4 py-2 text-base text-text-secondary">{load.name}</td>
                      <td class="px-4 py-2 text-right text-base text-text-primary">
                        {load.gel_penetration_in ? `${load.gel_penetration_in}"` : '—'}
                      </td>
                      <td class="px-4 py-2 text-right text-base text-text-primary">
                        {load.expansion_diameter_in ? `${load.expansion_diameter_in}"` : '—'}
                      </td>
                      <td class={`px-4 py-2 text-center text-base ${load.barrier_blind === true ? 'text-success' : load.barrier_blind === false ? 'text-danger' : 'text-text-muted'}`}>
                        {load.barrier_blind === true ? 'Yes' : load.barrier_blind === false ? 'No' : '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="px-4 py-2 bg-surface-overlay border-t border-surface-border-subtle">
              <p class="font-mono text-xs text-text-muted">
                FBI protocol: 10-caliber ordnance gel, penetration measured in inches. "Barrier Blind" = consistent performance through heavy clothing, auto glass, plywood, and wallboard.
              </p>
            </div>
          </div>
        )}

        <!-- Ballistics Chart -->
        <BallisticsChart client:visible loads={d.loads} />

        <!-- Hunting Applications -->
        {d.recommended_game && d.recommended_game.length > 0 && (
          <div class="border border-surface-border">
            <div class="border-b border-surface-border bg-surface-overlay px-4 py-2.5">
              <h3 class="font-display text-base tracking-[0.2em] uppercase text-text-muted">Hunting Applications</h3>
            </div>
            <div class="divide-y divide-surface-border-subtle">
              {d.recommended_game.map((rec, i) => (
                <div class={`px-4 py-3 ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-mono text-base font-medium text-text-primary">{rec.game}</span>
                    <span class="font-mono text-sm text-accent flex-shrink-0">{rec.range}</span>
                  </div>
                  <p class="font-mono text-sm text-text-muted mt-1">{rec.notes}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Interchangeability & Safety -->
        {(d.compatible_chambers?.length || d.dangerous_substitutions?.length) && (
          <div class="border border-surface-border">
            <div class="border-b border-surface-border bg-surface-overlay px-4 py-2.5">
              <h3 class="font-display text-base tracking-[0.2em] uppercase text-text-muted">Interchangeability & Safety</h3>
            </div>

            {d.dangerous_substitutions && d.dangerous_substitutions.length > 0 && (
              <div class="border-b border-surface-border">
                <div class="px-4 py-2 bg-danger/10 border-b border-danger/20">
                  <span class="font-mono text-xs font-medium uppercase tracking-wider text-danger">Dangerous — Never Substitute</span>
                </div>
                <div class="divide-y divide-surface-border-subtle">
                  {d.dangerous_substitutions.map((sub, i) => (
                    <div class={`px-4 py-2.5 ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                      <span class="font-mono text-base font-medium text-danger">{sub.caliber}</span>
                      <p class="font-mono text-sm text-text-muted mt-0.5">{sub.danger}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {d.compatible_chambers && d.compatible_chambers.length > 0 && (
              <div>
                <div class="px-4 py-2 bg-success/10 border-b border-success/20">
                  <span class="font-mono text-xs font-medium uppercase tracking-wider text-success">Safe to Fire In This Chamber</span>
                </div>
                <div class="divide-y divide-surface-border-subtle">
                  {d.compatible_chambers.map((compat, i) => (
                    <div class={`px-4 py-2.5 ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                      <span class="font-mono text-base font-medium text-text-primary">{compat.caliber}</span>
                      <p class="font-mono text-sm text-text-muted mt-0.5">{compat.notes}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar -->
      <div class="space-y-6">
        <!-- Cartridge Diagram -->
        <CartridgeDiagram client:visible dimensions={d.dimensions} name={d.name} />

        <!-- Radar Profile -->
        <CaliberRadarChart
          client:visible
          energy={(d.typical_energy_ft_lbs[0] + d.typical_energy_ft_lbs[1]) / 2}
          range={d.effective_range_yd}
          recoil={d.recoil.free_recoil_ft_lbs}
          cost={(d.cost_per_round_usd[0] + d.cost_per_round_usd[1]) / 2}
          availability={d.availability_rating ?? 3}
        />

        <!-- Usage Badges -->
        <div class="border border-surface-border p-5">
          <UsageBadges
            military={d.military_usage}
            le={d.le_usage}
            useCases={d.primary_use_cases}
            militaryDetail={d.military_adoption_detail}
            leDetail={d.le_adoption_detail}
          />
        </div>

        <!-- Common Firearms -->
        <div class="border border-surface-border">
          <div class="border-b border-surface-border bg-surface-overlay px-4 py-2.5">
            <h3 class="font-display text-base tracking-[0.2em] uppercase text-text-muted">
              {linkedFirearms.length > 0 ? 'Firearms in This Caliber' : 'Common Firearms'}
            </h3>
          </div>
          {linkedFirearms.length > 0 ? (
            <div class="divide-y divide-surface-border-subtle">
              {linkedFirearms.map((f, i) => (
                <div class={`px-4 py-2.5 ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                  <div class="font-mono text-base font-medium text-text-primary">{f.data.name}</div>
                  <div class="font-mono text-xs text-text-muted mt-0.5">
                    {f.data.manufacturer} · {f.data.action} · {f.data.barrel_length_in}" barrel · {(f.data.weight_oz / 16).toFixed(1)} lb
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <ul class="divide-y divide-surface-border-subtle">
              {d.common_firearms.map((firearm, i) => (
                <li class={`px-4 py-2.5 font-mono text-base text-text-secondary ${i % 2 === 0 ? 'bg-surface' : 'bg-surface-raised'}`}>
                  {firearm}
                </li>
              ))}
            </ul>
          )}
        </div>

        <!-- Adoption Timeline -->
        {d.adoption_timeline && d.adoption_timeline.length > 0 && (
          <AdoptionTimeline events={d.adoption_timeline} />
        )}

        <!-- Cartridge Lineage -->
        <CartridgeLineage
          currentName={d.name}
          parent={parentRef}
          children={childRefs}
        />

        <!-- Compare Link -->
        <a
          href={`/caliber-companion/compare?c=${d.slug}`}
          class="flex items-center justify-center gap-2 border border-surface-border bg-surface-raised px-4 py-3 font-mono text-base tracking-wider uppercase text-text-secondary transition-colors hover:border-accent hover:text-accent"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
          Compare this caliber
        </a>
      </div>
    </div>

    <!-- Prose Content -->
    {Content && (
      <div class="mt-12 border-t border-surface-border pt-8">
        <div class="prose mx-auto max-w-3xl prose-headings:font-display prose-headings:tracking-[0.2em] prose-headings:uppercase prose-h2:text-2xl prose-h2:font-semibold prose-h2:text-accent prose-h2:border-b prose-h2:border-surface-border prose-h2:pb-3 prose-h2:mt-12 prose-h2:mb-5 prose-strong:text-text-primary">
          <Content />
        </div>
      </div>
    )}

    <!-- Related Calibers -->
    {relatedCalibers.length > 0 && (
      <div class="mt-12 border-t border-surface-border pt-8">
        <h2 class="font-display text-xl font-semibold tracking-[0.2em] uppercase text-text-muted mb-4">You Might Also Consider</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCalibers.map(rc => (
            <a
              href={`/caliber-companion/calibers/${rc.slug}`}
              class="group border border-surface-border bg-surface-raised p-4 transition-colors hover:border-accent"
            >
              <div class="font-mono text-base font-medium text-text-primary group-hover:text-accent transition-colors">
                {rc.name}
              </div>
              <div class="mt-1 font-mono text-xs text-text-muted">
                {titleCase(rc.category)}
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
