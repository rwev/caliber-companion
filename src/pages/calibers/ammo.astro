---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmmoFinder from '../../components/islands/AmmoFinder';
import { getCollection } from 'astro:content';

const calibers = await getCollection('caliberData');

const loads = calibers.flatMap(c =>
  c.data.loads.map(load => ({
    caliberName: c.data.name,
    caliberSlug: c.data.slug,
    category: c.data.category,
    loadName: load.name,
    bulletWeight: load.bullet_weight_gr,
    bulletType: load.bullet_type,
    muzzleVelocity: load.muzzle_velocity_fps,
    muzzleEnergy: load.muzzle_energy_ft_lbs,
    barrelLength: load.barrel_length_in,
    bcG1: load.bc_g1 ?? null,
    sectionalDensity: load.sectional_density ?? null,
    gelPenetration: load.gel_penetration_in ?? null,
    expansionDiameter: load.expansion_diameter_in ?? null,
    barrierBlind: load.barrier_blind ?? null,
  }))
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout breadcrumbs={[{ label: 'Calibers', href: '/calibers' }, { label: 'Ammo Finder' }]} title="Ammunition Finder" description="Search, filter, and compare ammunition loads across 100+ calibers. Find the right load by bullet type, weight, velocity, energy, and terminal performance.">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Ammunition Finder
      </h1>
      <p class="mt-2 text-base text-text-muted">
        {loads.length} loads across {calibers.length} calibers · search, filter, sort by any column
      </p>
    </div>

    <AmmoFinder client:idle loads={loads} basePath={base} />
  </div>
</BaseLayout>
