---
interface CaliberRef {
  slug: string;
  name: string;
}

interface Props {
  currentName: string;
  parent?: CaliberRef;
  children?: CaliberRef[];
}

const { currentName, parent, children = [] } = Astro.props;
const hasLineage = parent || children.length > 0;
---

{hasLineage && (
  <div class="rounded-lg border border-surface-border">
    <div class="rounded-t-lg border-b border-surface-border bg-surface-overlay px-4 py-2.5">
      <h3 class="text-sm font-semibold text-text-muted">Cartridge Lineage</h3>
    </div>
    <div class="px-4 py-4 space-y-3">
      {/* Parent */}
      {parent && (
        <div class="flex items-center gap-2">
          <span class="text-xs font-medium uppercase tracking-wide text-text-muted flex-shrink-0">Parent</span>
          <span class="text-text-muted" aria-hidden="true">→</span>
          <a
            href={`/calibers/${parent.slug}`}
            class="font-mono text-base text-accent hover:underline"
          >
            {parent.name}
          </a>
        </div>
      )}

      {/* Current */}
      <div class="flex items-center gap-2">
        {parent && <div class="w-px h-4 bg-surface-border ml-3" aria-hidden="true"></div>}
        <span class="font-mono text-base font-medium text-text-primary border-l-2 border-accent pl-2">
          {currentName}
        </span>
      </div>

      {/* Children */}
      {children.length > 0 && (
        <div class="space-y-1.5 ml-3 border-l border-surface-border pl-3">
          <span class="text-xs font-medium uppercase tracking-wide text-text-muted">Derived</span>
          {children.map((child) => (
            <div class="flex items-center gap-2">
              <span class="text-text-muted" aria-hidden="true">↳</span>
              <a
                href={`/calibers/${child.slug}`}
                class="font-mono text-base text-accent hover:underline"
              >
                {child.name}
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
)}
