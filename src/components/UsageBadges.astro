---
interface MilitaryAdoption {
  organization: string;
  designation?: string;
  year_adopted?: number;
  role: string;
  status: 'active' | 'retired';
}

interface LEAdoption {
  organization: string;
  year_adopted?: number;
  role: string;
  status: 'active' | 'retired';
}

interface Props {
  military: string[];
  le: string[];
  useCases: string[];
  militaryDetail?: MilitaryAdoption[];
  leDetail?: LEAdoption[];
}

const { military, le, useCases, militaryDetail, leDetail } = Astro.props;
---

<div class="space-y-4">
  {/* Military - structured detail if available, otherwise badges */}
  {militaryDetail && militaryDetail.length > 0 ? (
    <div>
      <div class="mb-2 font-mono text-sm tracking-[0.2em] uppercase text-text-muted">Military Adoption</div>
      <div class="space-y-2">
        {militaryDetail.map(entry => (
          <div class={`border px-2.5 py-2 font-mono text-sm ${entry.status === 'active' ? 'border-success/30 bg-success/10' : 'border-surface-border bg-surface-overlay'}`}>
            <div class={`font-medium ${entry.status === 'active' ? 'text-success' : 'text-text-muted'}`}>
              {entry.organization}
              {entry.designation && <span class="text-text-muted font-normal"> — {entry.designation}</span>}
            </div>
            <div class="text-xs text-text-muted mt-0.5">
              {entry.role}
              {entry.year_adopted && <span> · {entry.year_adopted}</span>}
              <span class={`ml-1 ${entry.status === 'active' ? 'text-success' : 'text-text-muted'}`}>
                · {entry.status === 'active' ? 'Active' : 'Retired'}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  ) : military.length > 0 && (
    <div>
      <div class="mb-2 font-mono text-sm tracking-[0.2em] uppercase text-text-muted">Military Adoption</div>
      <div class="flex flex-wrap gap-2">
        {military.map(item => (
          <span class="border border-success/30 bg-success/10 px-2.5 py-1 font-mono text-sm text-success">
            {item}
          </span>
        ))}
      </div>
    </div>
  )}

  {/* LE - structured detail if available, otherwise badges */}
  {leDetail && leDetail.length > 0 ? (
    <div>
      <div class="mb-2 font-mono text-sm tracking-[0.2em] uppercase text-text-muted">Law Enforcement</div>
      <div class="space-y-2">
        {leDetail.map(entry => (
          <div class={`border px-2.5 py-2 font-mono text-sm ${entry.status === 'active' ? 'border-info/30 bg-info/10' : 'border-surface-border bg-surface-overlay'}`}>
            <div class={`font-medium ${entry.status === 'active' ? 'text-info' : 'text-text-muted'}`}>
              {entry.organization}
            </div>
            <div class="text-xs text-text-muted mt-0.5">
              {entry.role}
              {entry.year_adopted && <span> · {entry.year_adopted}</span>}
              <span class={`ml-1 ${entry.status === 'active' ? 'text-info' : 'text-text-muted'}`}>
                · {entry.status === 'active' ? 'Active' : 'Retired'}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  ) : le.length > 0 && (
    <div>
      <div class="mb-2 font-mono text-sm tracking-[0.2em] uppercase text-text-muted">Law Enforcement</div>
      <div class="flex flex-wrap gap-2">
        {le.map(item => (
          <span class="border border-info/30 bg-info/10 px-2.5 py-1 font-mono text-sm text-info">
            {item}
          </span>
        ))}
      </div>
    </div>
  )}

  {useCases.length > 0 && (
    <div>
      <div class="mb-2 font-mono text-sm tracking-[0.2em] uppercase text-text-muted">Primary Use Cases</div>
      <div class="flex flex-wrap gap-2">
        {useCases.map(item => (
          <span class="border border-surface-border bg-surface-overlay px-2.5 py-1 font-mono text-sm text-text-secondary">
            {item}
          </span>
        ))}
      </div>
    </div>
  )}
</div>
