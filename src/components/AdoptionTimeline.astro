---
interface Props {
  events: Array<{ year: number; event: string }>;
}

const { events } = Astro.props;
const sorted = [...events].sort((a, b) => a.year - b.year);
---

<div class="rounded-lg border border-surface-border">
  <div class="rounded-t-lg border-b border-surface-border bg-surface-overlay px-4 py-2.5">
    <h3 class="text-sm font-semibold text-text-muted">Adoption Timeline</h3>
  </div>
  <div class="relative py-4 px-4">
    {/* Vertical line */}
    <div class="absolute left-[1.65rem] top-4 bottom-4 w-px bg-surface-border" aria-hidden="true"></div>

    <ol class="relative space-y-0">
      {sorted.map((entry, i) => (
        <li class="flex items-start gap-3 py-2.5">
          {/* Dot */}
          <div class="relative z-10 mt-1.5 flex-shrink-0">
            <div class="h-2.5 w-2.5 rounded-full border border-accent bg-accent/20"></div>
          </div>
          {/* Content */}
          <div class="flex-1 min-w-0">
            <span class="font-mono text-sm font-medium text-accent">{entry.year}</span>
            <p class="text-base text-text-secondary leading-snug mt-0.5">{entry.event}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>
